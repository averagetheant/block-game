-- Shared config / tunables for TowerGame.
-- Plain .luau file => shipped to ReplicatedStorage, readable from any realm.
--
-- The game is played on a single 2D plane (all blocks share Z = PLANE_Z) so the
-- physics reads like Tricky Towers rather than a 3D pile. TowerService enforces
-- that plane; everything here is the numbers it enforces it with.

return {
	-- ---------------------------------------------------------------- arena --
	-- Every block lives on this Z slice. The camera looks down -Z at it.
	PLANE_Z = 0,
	-- One tetromino cell. Blocks are cubes of BLOCK_SIZE with BLOCK_DEPTH depth;
	-- keeping depth == size makes the pieces stable against out-of-plane tipping.
	BLOCK_SIZE = 4,
	BLOCK_DEPTH = 4,
	-- Used for BOTH the starting base and every storm checkpoint platform, so a
	-- checkpoint is visibly "another floor" of the same building.
	PLATFORM_SIZE = Vector3.new(48, 4, 8),
	-- The foundation the tower is built on. Generated by TowerService unless a
	-- part tagged BASE_TAG already exists (see docs/game/TowerGame.md).
	BASE_TAG = "TowerBase",
	BASE_POSITION = Vector3.new(0, 40, 0),
	BASE_COLOR = Color3.fromRGB(56, 60, 74),
	ARENA_NAME = "TowerArena",
	-- Attribute on the arena folder holding the base's top surface Y. The client
	-- camera needs that number and can't get it from BASE_TAG: tags applied at
	-- runtime on the server do NOT replicate, while attributes do.
	BASE_TOP_ATTRIBUTE = "BaseTopY",
	-- Attribute the server stamps on the held piece with its owner's user id. The
	-- holder's client uses it to find the piece it should hide and shadow with a
	-- local preview; everyone else just watches the real thing.
	HELD_ATTRIBUTE = "HolderUserId",
	-- Attribute marking a piece that brought its own model (the Noob) rather than
	-- being built out of tetromino cells. Zone dressing skips those: studding a
	-- Noob over or handing it snow friction turns a character back into a prop.
	RAW_MODEL_ATTRIBUTE = "RawModel",
	-- Nobody walks around in a stationary-camera stacking game, so characters are
	-- off by default. Flip to false to get avatars back (they spawn at the world
	-- origin and are unrelated to the tower).
	DISABLE_CHARACTERS = true,

	-- ---------------------------------------------------------------- turns --
	-- Hard cap on how long the holder may aim before the piece drops itself.
	TURN_SECONDS = 15,
	-- Grace period after a drop before the next player is handed a piece.
	SETTLE_SECONDS = 1.5,
	-- Clear air between the *bottom* of a fresh piece and the top of everything it
	-- could land on. Measured from the piece's lowest possible point — the one it
	-- would have after a quarter turn, since the holder can spin it at any moment
	-- — so a tall piece spawns higher instead of spawning inside the tower it is
	-- meant to land on.
	SPAWN_CLEARANCE = 14,
	-- Horizontal travel limit from the arena center, in studs. Just inside the
	-- platform's half width so a piece can overhang but not fly off into space.
	STEER_LIMIT_X = 22,
	-- Studs per second while a direction is held. Steering is continuous, not
	-- one cell per press.
	STEER_SPEED = 18,
	-- ----------------------------------------------------- the steering stick --
	-- Touch steering: a horizontal track with a knob dragged along it, reporting
	-- a continuous [-1, 1] into the same analog `setSteer` the gamepad uses.
	-- One axis, because the game is one axis — a round stick would promise a
	-- vertical control the piece doesn't have.
	--
	-- Wide, because precision here is the whole game and a thumb is blunt: the
	-- track's half-width is the full steering range, so a wider track means finer
	-- control per pixel of travel.
	STICK_TRACK_WIDTH = 260,
	STICK_TRACK_HEIGHT = 74,
	STICK_KNOB_SIZE = 62,
	STICK_TRACK_COLOR = Color3.fromRGB(18, 20, 30),
	STICK_KNOB_COLOR = Color3.fromRGB(86, 142, 255),
	STICK_STROKE_COLOR = Color3.fromRGB(226, 230, 245),
	-- Placement streaming: the holder's client owns the *feel* of aiming and
	-- reports where the piece is. This is how often that report goes out (the
	-- rate spectators see the piece move at) and the movement below which it
	-- isn't worth a packet.
	AIM_INTERVAL = 1 / 30,
	AIM_EPSILON = 0.05,

	-- ---------------------------------------------------------------- gamepad --
	-- The left stick steers (analog, so a gentle push nudges) as an *alternative*
	-- to the D-pad and the bumpers, never a replacement — all three stay live.
	-- The right stick isn't a piece control at all: it drives the player's cursor.
	--
	-- Below this the left stick reads as centred, and control goes back to
	-- whatever the D-pad or bumpers are doing. Generous — a resting stick that
	-- drifts would otherwise slide the piece on its own.
	GAMEPAD_STEER_DEADZONE = 0.2,

	-- ----------------------------------------------------------------- blocks --
	-- Impact sounds: below this speed a collision is a nudge, not a landing.
	IMPACT_MIN_SPEED = 12,
	-- Speed at which an impact is at full volume.
	IMPACT_LOUD_SPEED = 70,
	-- One impact sound per block per this many seconds, so a piece skittering
	-- down a tower doesn't machine-gun the kit.
	IMPACT_COOLDOWN = 0.25,
	-- Rolloff for block sounds, in studs.
	SOUND_RANGE = 140,
	-- Bomb blocks. Sized to actually gut a tower: the radius covers several
	-- courses of blocks and the pressure is enough to throw them clear rather
	-- than nudge them. A bomb should be a moment, not a bump.
	EXPLOSION_RADIUS = 46,
	EXPLOSION_PRESSURE = 1600000,
	-- Extra outward kick applied by hand to everything in radius. BlastPressure
	-- alone falls off sharply and barely moves the heavy welded assemblies, so
	-- this is what gives the blast its throw.
	EXPLOSION_IMPULSE = 145,
	-- The blast is the loudest thing in the game; the kit's clip on its own sits
	-- level with a block landing, which undersells it.
	EXPLOSION_VOLUME = 1.7,
	-- A bomb doesn't go off on contact — it warns first. Three beeps with the
	-- piece flashing red, which is long enough for the room to see it coming and
	-- short enough that the tower hasn't finished settling around it.
	BOMB_BEEPS = 3,
	BOMB_BEEP_ON = 0.14,
	BOMB_BEEP_OFF = 0.28,
	BOMB_FLASH_COLOR = Color3.fromRGB(255, 38, 28),
	-- Glue blocks: how far a contact can be and still get welded.
	GLUE_RADIUS = 6,
	-- Clone blocks: the copy drops in this far above where the original settled,
	-- nudged sideways so it can't balance perfectly on its own parent.
	CLONE_RISE = 16,
	CLONE_OFFSET_X = 3,
	-- Bouncy blocks: elasticity replaces the dead landing of BLOCK_PHYSICS. The
	-- high elasticityWeight is what makes the bounce survive contact with the
	-- ordinary, completely inelastic blocks it lands on.
	-- (density, friction, elasticity, frictionWeight, elasticityWeight)
	BOUNCY_PHYSICS = PhysicalProperties.new(0.8, 0.35, 0.72, 1, 10),
	-- Burning blocks. A lit block blackens over BURN_SECONDS and then falls
	-- apart, and anything resting against it catches too — so the hazard isn't
	-- the block, it's the hole it leaves in the tower.
	BURN_SECONDS = 20,
	-- How far a contact can be and still catch. Deliberately tight: touching,
	-- not nearby.
	BURN_SPREAD_RADIUS = 1.2,
	-- Grace before a lit block can pass it on, so a burning piece doesn't ignite
	-- the whole course it lands in on the same frame.
	BURN_SPREAD_DELAY = 2.5,
	-- Fraction of the burn spent visibly falling apart (fading out) at the end.
	BURN_FADE_FRACTION = 0.25,
	-- Noob blocks. Slow enough to watch, jumpy enough to be a menace to whoever
	-- is trying to land a piece next to one.
	NOOB_WALK_SPEED = 8,
	NOOB_JUMP_POWER = 50,
	NOOB_JUMP_CHANCE = 0.35,
	NOOB_STEP_SECONDS = 1.6,
	-- How long the ragdoll is left lying there after it's squashed.
	NOOB_DESPAWN_SECONDS = 2.5,

	-- ------------------------------------------------------------------ zones --
	-- Studio-authored asset folders (Rojo doesn't sync these; see docs).
	ASSETS_FOLDER = "Assets",
	-- Snowy: friction drops through the floor, everything slides.
	SNOWY_PHYSICS = PhysicalProperties.new(0.8, 0.05, 0, 1, 1),
	-- Stormy: a constant sideways nudge, in studs/second² of acceleration. Small
	-- enough to lean a tower rather than sweep it away.
	STORM_WIND = 5.5,
	-- How long the wind holds one direction before drifting to a new one.
	STORM_GUST_SECONDS = 4,
	-- How long the "special zone" banner stays up.
	ZONE_WARNING_SECONDS = 4.5,
	-- Height above the tower top that weather effects are parented at, so the
	-- particles fall through the play area rather than starting inside it.
	WEATHER_HEIGHT = 90,

	-- ------------------------------------------------------------------- cash --
	CASH_PER_ZONE = 50,
	-- Paid to whoever placed the block, per stud the tower's record grew by.
	-- Rewards the player who actually pushed it higher rather than the room.
	CASH_PER_STUD = 2,
	CASH_PER_INTERVAL = 10,
	CASH_INTERVAL_SECONDS = 300,
	-- How many bills fly to the counter per award, and how long they take.
	CASH_FLY_COUNT = 12,
	CASH_FLY_SECONDS = 0.75,
	CASH_IMAGE = "rbxassetid://73395222638222",

	-- ------------------------------------------------------------------ hud --
	-- Headshot strip: the current player sits dead center at the larger size,
	-- everyone else shrinks and fades out either side of them.
	AVATAR_SIZE = 64,
	AVATAR_SIZE_INACTIVE = 44,
	AVATAR_SPACING = 58,
	AVATAR_FADE_INACTIVE = 0.45,
	-- Cap on how many players the strip draws (centered on the current one).
	AVATAR_MAX_SHOWN = 7,
	-- The controls hint shows for this long, then fades out over its own tween.
	HINT_SECONDS = 60,
	HINT_FADE_SECONDS = 1.5,

	-- ---------------------------------------------------------------- storm --
	-- The pressure mechanic: reach the target height before the clock runs out
	-- and the tower gains a permanent floor to build on. Miss it and the storm
	-- takes the whole tower — see STORM_BLAST_* below.
	--
	-- Clearing a stage also *wipes the blocks below the new platform* — the
	-- checkpoint becomes a clean foundation hanging in the air, which is what
	-- keeps a long session from dragging a thousand physics parts behind it.
	STORM_SECONDS = 300,
	-- Distance to the first checkpoint, in studs above the base.
	STORM_FIRST_TARGET = 60,
	-- Every cleared stage puts the next checkpoint this much further out than
	-- the last gap: 60, then 65, then 70…
	STORM_GAP_GROWTH = 5,
	-- When the clock runs out the tower is thrown apart rather than quietly
	-- deleted. Random horizontal shove + upward kick, then cleanup.
	STORM_BLAST_HORIZONTAL = 90,
	STORM_BLAST_UP = 55,
	STORM_BLAST_SPIN = 12,
	-- How long the debris is left flying before it's cleared and the run resets.
	STORM_BLAST_SECONDS = 2.5,
	-- The storm announces itself before it arrives: the camera starts shaking
	-- this many seconds out and builds until it hits. Client-side (the camera is
	-- a presentation), driven off the same `stormEndsAt` the clock reads, so
	-- nothing extra goes over the wire for it.
	STORM_SHAKE_LEAD_SECONDS = 30,
	-- Peak jitter at the moment the storm lands: studs of positional shake, and
	-- degrees of roll. Small numbers — the camera is close to the tower, so a
	-- stud reads as a lot more movement than it sounds like.
	STORM_SHAKE_OFFSET = 1.1,
	STORM_SHAKE_TILT_DEGREES = 0.7,
	-- How fast the shake oscillates. Sampled from math.noise rather than random
	-- per frame, so it reads as rumble rather than static.
	STORM_SHAKE_FREQUENCY = 17,
	-- The white-out when the storm takes the tower. The delay is what lets the
	-- players actually see the wreck fly before the screen goes: blocks first,
	-- then white, then it clears onto the empty arena and the vote.
	STORM_FADE_DELAY_SECONDS = 0.8,
	STORM_FADE_IN_SECONDS = 1.2,
	-- How long full white is held before it starts clearing.
	STORM_FADE_HOLD_SECONDS = 0.5,
	STORM_FADE_OUT_SECONDS = 1.3,
	-- Checkpoint platform entrance: stretches out from a sliver, glowing white,
	-- then cools to black.
	PLATFORM_GROW_SECONDS = 0.45,
	PLATFORM_FADE_SECONDS = 1.1,
	PLATFORM_SPAWN_COLOR = Color3.fromRGB(255, 255, 255),
	PLATFORM_SETTLED_COLOR = Color3.fromRGB(12, 12, 16),

	-- ----------------------------------------------------------- checkpoints --
	-- Clearing a stage isn't a number going up, it's a cutscene: play stops, the
	-- camera pulls back far enough to show the whole leg the players just built,
	-- the scaffolding under the new floor is blown apart, and then the camera
	-- comes back and the next turn starts. The server drives the beats; the
	-- camera follows PHASE.CHECKPOINT and needs no cue of its own.
	--
	-- Total pause is the sum of these four, plus PLATFORM_GROW_SECONDS.
	CHECKPOINT_PAUSE_SECONDS = 0.7,
	-- The wide shot is held this long before anything blows up, so the tower gets
	-- a moment of being looked at.
	CHECKPOINT_VIEW_SECONDS = 1.5,
	-- How long the debris flies before it's cleared.
	CHECKPOINT_BLAST_SECONDS = 2,
	-- Beat after the dust settles before the queue picks back up.
	CHECKPOINT_RESUME_SECONDS = 0.8,
	-- How hard the old tower is thrown. Softer than the storm's blast: this one
	-- is a demolition, not a punishment.
	CHECKPOINT_BLAST_HORIZONTAL = 65,
	CHECKPOINT_BLAST_UP = 45,
	CHECKPOINT_BLAST_SPIN = 9,

	-- --------------------------------------------------------- the round break --
	-- The storm taking the tower ends the *round*, and the round break is the
	-- pause that follows: the wreck flies, the screen goes white, the players vote
	-- on how the next round plays, and then a fresh run starts on those numbers.
	--
	-- Everything is parked for the whole of it — the turn queue, the storm clock,
	-- and the height poll — so the vote isn't a thing happening *over* a game
	-- that's still running underneath it.
	--
	-- How long the wreck is left to fly before the vote opens over it. Long enough
	-- to read as a consequence; the blast itself is STORM_BLAST_SECONDS.
	ROUND_BREAK_WRECK_SECONDS = 3,
	-- Beat after the vote closes before the first piece of the new round appears,
	-- so the fade back in has somewhere to land.
	ROUND_BREAK_RESUME_SECONDS = 1,

	-- --------------------------------------------------------------- physics --
	-- Grippy and dead: high friction so a stack doesn't slide itself apart, zero
	-- elasticity so a dropped piece lands instead of bouncing off the tower.
	-- (density, friction, elasticity, frictionWeight, elasticityWeight)
	BLOCK_PHYSICS = PhysicalProperties.new(0.8, 0.9, 0, 10, 1),
	-- A block is a candidate for "settled" once its assembly is this slow and
	-- this close to not spinning.
	SETTLED_SPEED = 0.6,
	SETTLED_SPIN = 0.6,
	-- …but it only *counts* once it has stayed that slow for this long. Without
	-- the hold, a block thrown up by a bomb is momentarily motionless at the top
	-- of its arc, and a block that is briefly motionless in mid-air was enough to
	-- hand the players a checkpoint they hadn't built to. Anything above these
	-- speeds knocks a settled block back out of the count.
	SETTLE_CONFIRM_SECONDS = 0.45,
	UNSETTLE_SPEED = 2.5,
	UNSETTLE_SPIN = 2,
	-- Blocks that fall this far below the base top are cleaned up. Pieces only
	-- ever spawn *above* the tower, so anything under the platform has fallen off
	-- the side — and if the place has a baseplate it would otherwise sit there
	-- forever instead of falling out of the world.
	DESPAWN_BELOW = 20,
	-- Out-of-plane drift past this many studs gets corrected (the velocity clamp
	-- handles the rest).
	PLANE_TOLERANCE = 0.25,

	-- --------------------------------------------------------------- tempo --
	-- Height recompute + state broadcast interval, seconds.
	POLL_INTERVAL = 0.2,
	-- Height change that's worth a broadcast, studs.
	HEIGHT_EPSILON = 0.05,

	-- --------------------------------------------------------------- camera --
	-- Stationary framing: the camera never orbits, it only rides the altitude of
	-- the tower's highest point.
	CAMERA_DISTANCE = 78,
	-- The camera looks dead level at a point this far above the tower top, which
	-- puts the tower and the piece waiting at SPAWN_CLEARANCE both in frame.
	CAMERA_AIM_LIFT = 10,
	-- Phone framing. A phone held upright has far less vertical room than a
	-- monitor, so the desktop lift put the tower top near the middle of the
	-- screen and everything the player had built ran off the bottom — it read as
	-- the camera sitting too high. Aiming lower and standing further back gives
	-- the stack back without losing the piece waiting overhead.
	CAMERA_AIM_LIFT_TOUCH = 1,
	CAMERA_DISTANCE_TOUCH = 94,
	-- Minimum altitude the camera frames, so an empty base isn't at the top edge.
	CAMERA_MIN_HEIGHT = 14,
	-- Exponential follow rate (higher = snappier).
	CAMERA_LERP = 4,
	-- The checkpoint pull-back is a camera move the player is meant to watch, so
	-- it eases rather than tracks.
	CAMERA_CHECKPOINT_LERP = 1.6,
	-- Headroom either side of the tower in the checkpoint wide shot, in studs.
	CAMERA_CHECKPOINT_PADDING = 34,
	-- Floor on the pull-back, as a multiple of the normal shot's distance. A
	-- short leg already fits in the ordinary framing, so fitting it is not enough
	-- — the move has to *read* as stepping back to look at what was built.
	CAMERA_CHECKPOINT_PULLBACK = 1.6,
	-- Ceiling on the pull-back, so a monstrous leg doesn't put the camera in
	-- orbit and the tower in one pixel.
	CAMERA_MAX_DISTANCE = 420,
	CAMERA_FOV = 60,
	-- Headroom left above the held piece when the camera has to stretch upward to
	-- keep it in frame. The piece always clears the tower (SPAWN_CLEARANCE), so
	-- the camera has to be willing to follow it up there.
	CAMERA_PIECE_MARGIN = 6,
	-- Half the width of the play area the camera must always show, in studs: the
	-- steering limit (22) plus a piece's own half width (8), plus a little air.
	-- Roblox's FieldOfView is *vertical*, so a phone held upright frames the same
	-- height as a monitor and far less width — the camera reads the real viewport
	-- aspect and stands back far enough to cover this on whatever screen it's on.
	CAMERA_MIN_HALF_WIDTH = 34,

	-- ----------------------------------------------------------------- store --
	-- Developer products, configured on the Roblox place. Ids are the live ones
	-- — a product id can't be invented locally, so these are the numbers or the
	-- purchase prompt errors.
	--
	-- The cash bundles are granted generically by StoreService (grant `amount`
	-- of `currency`); the two action products run handlers registered by
	-- TowerProductsService.
	PRODUCTS = {
		CASH_500 = 3707809246,
		CASH_1000 = 3707809250,
		CASH_10000 = 3707809258,
		-- Throws the whole tower off the plane and starts the run over — the
		-- storm's outcome, bought.
		NUKE = 3707809217,
		-- Jumps the tower up to the target height and clears the stage there,
		-- cutscene and all — buys the climb, not just a floor wherever play
		-- happened to stop.
		NEXT_CHECKPOINT = 3707809233,
	},
	-- The soft currency id this feature registers with the Store. Its balance
	-- lives at { PROFILE_KEY, "Cash" } — Store debits it through that path.
	CURRENCY_ID = "coins",

	-- ------------------------------------------------------------ persistence --
	-- Top-level profile key this feature owns (registered in PlayerData.luau).
	PROFILE_KEY = "TowerGame",
	-- leaderstats value names, shown on the in-game leaderboard.
	STAT_BLOCKS = "Blocks Placed",
	STAT_HEIGHT = "Biggest Height",

	-- --------------------------------------------------------------- phases --
	-- Broadcast as a uint8; the HUD reads it to pick its status line.
	PHASE = {
		IDLE = 0, -- nobody in the queue
		AIMING = 1, -- a player holds a piece and the clock is running
		SETTLING = 2, -- piece dropped, physics resolving
		CHECKPOINT = 3, -- stage cleared: play is paused for the demolition
		-- The storm took the tower. The round is over and the next one hasn't
		-- started: the wreck is flying, the screen is fading white, and the vote
		-- for the next round's rules runs inside this phase. Nothing may be
		-- placed while it's up — see `intermission` in TowerService.
		GAMEOVER = 4,
	},

	-- Which surfaces this feature renders. Flip one off to drop that surface
	-- without deleting code (see docs/game/presentations.md).
	Presentations = {
		hud = true,
		camera = true,
		input = true,
		-- Mouse aiming + click-to-drop. PC only; ignored on touch.
		pointer = true,
		-- `skipstage` — a dev handle on the stage clear. Gated by Cmdr's username
		-- allowlist like every other command; turn it off for a public build.
		command = true,
		-- The two Robux buttons on the left rail (Nuke, Next Checkpoint) and the
		-- server handlers behind them. Off = the products stop being offered and
		-- any receipt for one is left undelivered rather than silently eaten.
		actions = true,
	},
}
