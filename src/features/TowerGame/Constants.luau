-- Shared config / tunables for TowerGame.
-- Plain .luau file => shipped to ReplicatedStorage, readable from any realm.
--
-- The game is played on a single 2D plane (all blocks share Z = PLANE_Z) so the
-- physics reads like Tricky Towers rather than a 3D pile. TowerService enforces
-- that plane; everything here is the numbers it enforces it with.

return {
	-- ---------------------------------------------------------------- arena --
	-- Every block lives on this Z slice. The camera looks down -Z at it.
	PLANE_Z = 0,
	-- One tetromino cell. Blocks are cubes of BLOCK_SIZE with BLOCK_DEPTH depth;
	-- keeping depth == size makes the pieces stable against out-of-plane tipping.
	BLOCK_SIZE = 4,
	BLOCK_DEPTH = 4,
	-- Used for BOTH the starting base and every storm checkpoint platform, so a
	-- checkpoint is visibly "another floor" of the same building.
	PLATFORM_SIZE = Vector3.new(48, 4, 8),
	-- The foundation the tower is built on. Generated by TowerService unless a
	-- part tagged BASE_TAG already exists (see docs/game/TowerGame.md).
	BASE_TAG = "TowerBase",
	BASE_POSITION = Vector3.new(0, 40, 0),
	BASE_COLOR = Color3.fromRGB(56, 60, 74),
	ARENA_NAME = "TowerArena",
	-- Attribute on the arena folder holding the base's top surface Y. The client
	-- camera needs that number and can't get it from BASE_TAG: tags applied at
	-- runtime on the server do NOT replicate, while attributes do.
	BASE_TOP_ATTRIBUTE = "BaseTopY",
	-- Attribute the server stamps on the held piece with its owner's user id. The
	-- holder's client uses it to find the piece it should hide and shadow with a
	-- local preview; everyone else just watches the real thing.
	HELD_ATTRIBUTE = "HolderUserId",
	-- Nobody walks around in a stationary-camera stacking game, so characters are
	-- off by default. Flip to false to get avatars back (they spawn at the world
	-- origin and are unrelated to the tower).
	DISABLE_CHARACTERS = true,

	-- ---------------------------------------------------------------- turns --
	-- Hard cap on how long the holder may aim before the piece drops itself.
	TURN_SECONDS = 20,
	-- Grace period after a drop before the next player is handed a piece.
	SETTLE_SECONDS = 1.5,
	-- How far above the current tower top a fresh piece is spawned.
	SPAWN_CLEARANCE = 18,
	-- Horizontal travel limit from the arena center, in studs. Just inside the
	-- platform's half width so a piece can overhang but not fly off into space.
	STEER_LIMIT_X = 22,
	-- Studs per second while a direction is held. Steering is continuous, not
	-- one cell per press.
	STEER_SPEED = 18,
	-- A touch tap has no key-up, so the HUD buttons send a pulse of this length
	-- instead: one tap ≈ STEER_SPEED * TOUCH_NUDGE_SECONDS studs of travel.
	TOUCH_NUDGE_SECONDS = 0.16,
	-- Placement streaming: the holder's client owns the *feel* of aiming and
	-- reports where the piece is. This is how often that report goes out (the
	-- rate spectators see the piece move at) and the movement below which it
	-- isn't worth a packet.
	AIM_INTERVAL = 1 / 30,
	AIM_EPSILON = 0.05,

	-- ----------------------------------------------------------------- blocks --
	-- Impact sounds: below this speed a collision is a nudge, not a landing.
	IMPACT_MIN_SPEED = 12,
	-- Speed at which an impact is at full volume.
	IMPACT_LOUD_SPEED = 70,
	-- One impact sound per block per this many seconds, so a piece skittering
	-- down a tower doesn't machine-gun the kit.
	IMPACT_COOLDOWN = 0.25,
	-- Rolloff for block sounds, in studs.
	SOUND_RANGE = 140,
	-- Explosion blocks. Sized to actually gut a tower: the radius covers several
	-- courses of blocks and the pressure is enough to throw them clear rather
	-- than nudge them. An explosive piece should be a moment, not a bump.
	EXPLOSION_RADIUS = 46,
	EXPLOSION_PRESSURE = 1600000,
	-- Extra outward kick applied by hand to everything in radius. BlastPressure
	-- alone falls off sharply and barely moves the heavy welded assemblies, so
	-- this is what gives the blast its throw.
	EXPLOSION_IMPULSE = 145,
	-- Glue blocks: how far a contact can be and still get welded.
	GLUE_RADIUS = 6,

	-- ------------------------------------------------------------------ zones --
	-- Studio-authored asset folders (Rojo doesn't sync these; see docs).
	ASSETS_FOLDER = "Assets",
	-- Snowy: friction drops through the floor, everything slides.
	SNOWY_PHYSICS = PhysicalProperties.new(0.8, 0.05, 0, 1, 1),
	-- Stormy: a constant sideways nudge, in studs/second² of acceleration. Small
	-- enough to lean a tower rather than sweep it away.
	STORM_WIND = 5.5,
	-- How long the wind holds one direction before drifting to a new one.
	STORM_GUST_SECONDS = 4,
	-- How long the "special zone" banner stays up.
	ZONE_WARNING_SECONDS = 4.5,
	-- Height above the tower top that weather effects are parented at, so the
	-- particles fall through the play area rather than starting inside it.
	WEATHER_HEIGHT = 90,

	-- ------------------------------------------------------------------- cash --
	CASH_PER_ZONE = 50,
	-- Paid to whoever placed the block, per stud the tower's record grew by.
	-- Rewards the player who actually pushed it higher rather than the room.
	CASH_PER_STUD = 2,
	CASH_PER_INTERVAL = 10,
	CASH_INTERVAL_SECONDS = 300,
	-- How many bills fly to the counter per award, and how long they take.
	CASH_FLY_COUNT = 12,
	CASH_FLY_SECONDS = 0.75,
	CASH_IMAGE = "rbxassetid://73395222638222",

	-- ------------------------------------------------------------------ hud --
	-- Headshot strip: the current player sits dead center at the larger size,
	-- everyone else shrinks and fades out either side of them.
	AVATAR_SIZE = 64,
	AVATAR_SIZE_INACTIVE = 44,
	AVATAR_SPACING = 58,
	AVATAR_FADE_INACTIVE = 0.45,
	-- Cap on how many players the strip draws (centered on the current one).
	AVATAR_MAX_SHOWN = 7,
	-- The controls hint shows for this long, then fades out over its own tween.
	HINT_SECONDS = 60,
	HINT_FADE_SECONDS = 1.5,

	-- ---------------------------------------------------------------- storm --
	-- The pressure mechanic: reach the target height before the clock runs out
	-- and the tower gains a permanent floor to build on. Miss it and the storm
	-- takes the whole tower — see STORM_BLAST_* below.
	--
	-- Clearing a stage also *wipes the blocks below the new platform* — the
	-- checkpoint becomes a clean foundation hanging in the air, which is what
	-- keeps a long session from dragging a thousand physics parts behind it.
	STORM_SECONDS = 300,
	-- Distance to the first checkpoint, in studs above the base.
	STORM_FIRST_TARGET = 60,
	-- Every cleared stage puts the next checkpoint this much further out than
	-- the last gap: 60, then 65, then 70…
	STORM_GAP_GROWTH = 5,
	-- When the clock runs out the tower is thrown apart rather than quietly
	-- deleted. Random horizontal shove + upward kick, then cleanup.
	STORM_BLAST_HORIZONTAL = 90,
	STORM_BLAST_UP = 55,
	STORM_BLAST_SPIN = 12,
	-- How long the debris is left flying before it's cleared and the run resets.
	STORM_BLAST_SECONDS = 2.5,
	-- Checkpoint platform entrance: stretches out from a sliver, glowing white,
	-- then cools to black.
	PLATFORM_GROW_SECONDS = 0.45,
	PLATFORM_FADE_SECONDS = 1.1,
	PLATFORM_SPAWN_COLOR = Color3.fromRGB(255, 255, 255),
	PLATFORM_SETTLED_COLOR = Color3.fromRGB(12, 12, 16),

	-- --------------------------------------------------------------- physics --
	-- Grippy and dead: high friction so a stack doesn't slide itself apart, zero
	-- elasticity so a dropped piece lands instead of bouncing off the tower.
	-- (density, friction, elasticity, frictionWeight, elasticityWeight)
	BLOCK_PHYSICS = PhysicalProperties.new(0.8, 0.9, 0, 10, 1),
	-- A block counts toward the tower height once its assembly is this slow.
	SETTLED_SPEED = 0.6,
	-- Blocks that fall this far below the base top are cleaned up. Pieces only
	-- ever spawn *above* the tower, so anything under the platform has fallen off
	-- the side — and if the place has a baseplate it would otherwise sit there
	-- forever instead of falling out of the world.
	DESPAWN_BELOW = 20,
	-- Out-of-plane drift past this many studs gets corrected (the velocity clamp
	-- handles the rest).
	PLANE_TOLERANCE = 0.25,

	-- --------------------------------------------------------------- tempo --
	-- Height recompute + state broadcast interval, seconds.
	POLL_INTERVAL = 0.2,
	-- Height change that's worth a broadcast, studs.
	HEIGHT_EPSILON = 0.05,

	-- --------------------------------------------------------------- camera --
	-- Stationary framing: the camera never orbits, it only rides the altitude of
	-- the tower's highest point.
	CAMERA_DISTANCE = 78,
	-- The camera looks dead level at a point this far above the tower top, which
	-- puts the tower and the piece waiting at SPAWN_CLEARANCE both in frame.
	CAMERA_AIM_LIFT = 10,
	-- Minimum altitude the camera frames, so an empty base isn't at the top edge.
	CAMERA_MIN_HEIGHT = 14,
	-- Exponential follow rate (higher = snappier).
	CAMERA_LERP = 4,
	CAMERA_FOV = 60,

	-- ------------------------------------------------------------ persistence --
	-- Top-level profile key this feature owns (registered in PlayerData.luau).
	PROFILE_KEY = "TowerGame",
	-- leaderstats value names, shown on the in-game leaderboard.
	STAT_BLOCKS = "Blocks Placed",
	STAT_HEIGHT = "Biggest Height",

	-- --------------------------------------------------------------- phases --
	-- Broadcast as a uint8; the HUD reads it to pick its status line.
	PHASE = {
		IDLE = 0, -- nobody in the queue
		AIMING = 1, -- a player holds a piece and the clock is running
		SETTLING = 2, -- piece dropped, physics resolving
	},

	-- Which surfaces this feature renders. Flip one off to drop that surface
	-- without deleting code (see docs/game/presentations.md).
	Presentations = {
		hud = true,
		camera = true,
		input = true,
		-- Mouse aiming + click-to-drop. PC only; ignored on touch.
		pointer = true,
	},
}
