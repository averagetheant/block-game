-- Shared config / tunables for TowerGame.
-- Plain .luau file => shipped to ReplicatedStorage, readable from any realm.
--
-- The game is played on a single 2D plane (all blocks share Z = PLANE_Z) so the
-- physics reads like Tricky Towers rather than a 3D pile. TowerService enforces
-- that plane; everything here is the numbers it enforces it with.

-- Friction shared by every ordinary surface in the game: a block, the ground, and
-- the two physics types that only mean to change something *else* (Anvil's
-- density, Feather's weight). One number rather than four copies — the moment they
-- disagree, a block grips differently depending on what it happens to be resting
-- on, which is the last thing a stacking game wants.
--
-- 1.2 on a scale that runs 0-2, up from 0.9. At 0.9 a piece laid neatly across two
-- others would creep, take the stack with it, and turn a good placement into a
-- collapse a second later. Ice is the one surface that opts out, because sliding
-- is the whole type.
local BLOCK_FRICTION = 1.2

return {
	-- ---------------------------------------------------------------- arena --
	-- Every block lives on this Z slice. The camera looks down -Z at it.
	PLANE_Z = 0,
	-- One tetromino cell. Blocks are cubes of BLOCK_SIZE with BLOCK_DEPTH depth;
	-- keeping depth == size makes the pieces stable against out-of-plane tipping.
	BLOCK_SIZE = 4,
	BLOCK_DEPTH = 4,
	-- Used for BOTH the starting base and every storm checkpoint platform, so a
	-- checkpoint is visibly "another floor" of the same building.
	PLATFORM_SIZE = Vector3.new(48, 4, 8),
	-- The foundation the tower is built on. Generated by TowerService unless a
	-- part tagged BASE_TAG already exists (see docs/game/TowerGame.md).
	BASE_TAG = "TowerBase",
	-- Folder in ServerStorage holding the ground layouts — one Model per layout,
	-- each a set of slabs the base and the checkpoint floors are stamped out
	-- from. Optional: with no folder (or nothing eligible) the game builds the
	-- plain PLATFORM_SIZE slab it always did. See docs/game/TowerPlatforms.md.
	PLATFORM_LAYOUTS_FOLDER = "TowerPlatformLayouts",
	BASE_POSITION = Vector3.new(0, 40, 0),
	BASE_COLOR = Color3.fromRGB(56, 60, 74),
	ARENA_NAME = "TowerArena",
	-- Attribute on the arena folder holding the base's top surface Y. The client
	-- camera needs that number and can't get it from BASE_TAG: tags applied at
	-- runtime on the server do NOT replicate, while attributes do.
	BASE_TOP_ATTRIBUTE = "BaseTopY",
	-- Attribute the server stamps on the held piece with its owner's user id. The
	-- holder's client uses it to find the piece it should hide and shadow with a
	-- local preview; everyone else just watches the real thing.
	HELD_ATTRIBUTE = "HolderUserId",
	-- Attribute marking a piece that brought its own model (the Noob) rather than
	-- being built out of tetromino cells. Zone dressing skips those: studding a
	-- Noob over or handing it snow friction turns a character back into a prop.
	RAW_MODEL_ATTRIBUTE = "RawModel",
	-- Attribute carrying the block's rolled skin id. The skin itself is a server
	-- decision the client can't re-derive — material is the wrong tell, because a
	-- purchased colour pack overrides it — and every client needs it to know how
	-- squishy the block should look. An attribute rather than a packet: it has to
	-- arrive with the block and stay attached to it for the block's whole life.
	SKIN_ATTRIBUTE = "SkinId",
	-- Marks the rounded shell a block is seen as. Client-only — the server never
	-- makes one — so this exists for the client-side passes that walk a block's
	-- parts (the zone dressing's lights, the aim preview's clone) and must not
	-- mistake a render part for a cell.
	BODY_ATTRIBUTE = "BlockBody",
	-- Which tetromino a piece was built from, so each client knows which rounded
	-- body to build over it. An attribute rather than a packet for the same reason
	-- the skin is one: it has to arrive with the block and stay attached for the
	-- block's whole life — including on the clone the aim preview makes of it,
	-- which is a piece the client has to dress without ever being told about.
	SHAPE_ATTRIBUTE = "ShapeId",
	-- Marks a block the Anchor type turned to stone. Zone dressing skips those for
	-- the same reason it skips a Noob: a statue is no longer a block wearing a
	-- skin, and re-materialling it on the next zone change would put the skin
	-- back. Read by the client too — its rounded body mirrors the cells.
	STATUE_ATTRIBUTE = "Statue",
	-- Nobody walks around in a stationary-camera stacking game, so characters are
	-- off by default. Flip to false to get avatars back (they spawn at the world
	-- origin and are unrelated to the tower).
	DISABLE_CHARACTERS = true,

	-- ---------------------------------------------------------------- turns --
	-- Hard cap on how long the holder may aim before the piece drops itself.
	TURN_SECONDS = 15,
	-- How long a turn runs for a holder who hasn't touched the piece yet. The
	-- full clock is granted the moment they steer or rotate it.
	--
	-- A stage is one shared budget of turns — STORM_SECONDS / (TURN_SECONDS +
	-- SETTLE_SECONDS), about 18 of them — and the room needs most of those to
	-- gain height. Someone who is away drops the piece from dead centre whatever
	-- the clock says, so the last ten seconds of their turn buy the room nothing
	-- and cost it a turn it needed. This gives those seconds back without
	-- hurrying anybody who is actually aiming.
	IDLE_TURN_SECONDS = 6,
	-- A player's first turn always gets the full clock: they are reading the
	-- controls hint, and cutting that one short teaches them the game is
	-- impatient before they have placed anything.
	IDLE_GRACE_TURNS = 1,
	-- The inactivity card is a question the player has to answer, so it sits over
	-- the HUD. Under the storm's white-out, which is drawn inside the HUD at its
	-- own ZIndex and covers the screen on purpose.
	AFK_Z_INDEX = 50,
	-- How far anything anchored to a screen edge sits in from it. Lives here
	-- rather than as a local in TowerHUD (where it started) because the HUD is no
	-- longer the only thing pinned to a corner, and two copies of the same margin
	-- drift the moment one is tuned.
	EDGE_MARGIN = 20,
	-- The badge that stays up while a player is out of the rotation. Centred,
	-- hanging just under the HUD's top column.
	--
	-- The corners were all tried and all lose. The right edge looks free until you
	-- measure it: the turn dial sits *outside* the top column and swings closer
	-- to the edge as the screen narrows (so it takes the corner on a phone), while
	-- the reaction bar owns a band from x 1459 across the vertical middle (so it
	-- takes the corner on a short window) — and the climb rail now runs down that
	-- edge between them. There is no fixed offset that clears them all; the
	-- hazards move in opposite directions as the aspect changes. Left is the
	-- sidebar rail, bottom-left the controls hint and the voice chips,
	-- bottom-right the cash counter.
	--
	-- Centre-x has no such neighbour at any size, and the only thing it can ever
	-- overlap is the tower itself — pixels, not buttons. It's also the most
	-- visible spot on the screen, which is the right trade for a badge that exists
	-- because somebody missed the message the first time.
	SPECTATOR_NOTICE_WIDTH = 330,
	-- Hangs this far below the GUI inset, clearing the HUD's top column (128
	-- canvas units now that the column is just the turn strip and the storm
	-- clock — the height readout moved to the climb rail on the right edge, and
	-- the panel that held it went with it). Authored in canvas units like the
	-- column itself, so the two stay in step at every viewport rather than only
	-- at the one they were checked on.
	SPECTATOR_NOTICE_TOP = 150,
	-- Note the badge does *not* sit at EDGE_MARGIN from the top. The root
	-- ScreenGui sets `IgnoreGuiInset`, so y = 0 is the true top of the display and
	-- the first stretch belongs to Roblox's own topbar — the player-list button is
	-- in this very corner. TowerAfkView adds the real inset back, converted into
	-- canvas units, because a constant can't do it: the inset is a fixed number of
	-- *screen* pixels while everything in here is scaled, so any offset big enough
	-- on a monitor is too small on the phone that needed it. See TowerAfkView.
	-- Red, matching the "Not playing" toggle's own variant in Settings, so the
	-- badge and the switch that causes it read as the same thing.
	SPECTATOR_NOTICE_COLOR = Color3.fromRGB(255, 138, 138),
	-- Consecutive untouched turns before the player is put in the "Not playing"
	-- seat and asked whether they're still there. Two rather than one: a single
	-- missed turn is a phone call or a tab switch, and the cost of being wrong
	-- (a player who has to press a button to keep playing) is paid by the player
	-- who did nothing wrong.
	IDLE_TURNS_BEFORE_AFK = 2,
	-- Grace period after a drop before the next player is handed a piece.
	SETTLE_SECONDS = 1.5,
	-- Clear air between the *bottom* of a fresh piece and the top of everything it
	-- could land on. Measured from the piece's lowest possible point — the one it
	-- would have after a quarter turn, since the holder can spin it at any moment
	-- — so a tall piece spawns higher instead of spawning inside the tower it is
	-- meant to land on.
	SPAWN_CLEARANCE = 14,
	-- Horizontal travel limit from the arena center, in studs. Just inside the
	-- platform's half width so a piece can overhang but not fly off into space.
	STEER_LIMIT_X = 22,
	-- Studs per second while a direction is held. Steering is continuous, not
	-- one cell per press.
	STEER_SPEED = 18,
	-- ----------------------------------------------------- the steering stick --
	-- Touch steering: a horizontal track with a knob dragged along it, reporting
	-- a continuous [-1, 1] into the same analog `setSteer` the gamepad uses.
	-- One axis, because the game is one axis — a round stick would promise a
	-- vertical control the piece doesn't have.
	--
	-- Wide, because precision here is the whole game and a thumb is blunt: the
	-- track's half-width is the full steering range, so a wider track means finer
	-- control per pixel of travel.
	STICK_TRACK_WIDTH = 260,
	-- Matches the TURN / DROP button height so the three controls read as one
	-- row. The knob isn't sized here: it's the track height minus the gem
	-- padding + stroke inset, computed at render so a live theme edit moves it.
	STICK_TRACK_HEIGHT = 88,
	-- How far past the end of the track the knob may follow the finger, as a
	-- multiple of the track's half-width. Steering is already saturated by then;
	-- this exists purely so the knob doesn't stop dead under a thumb that's still
	-- moving, which reads as the control letting go.
	STICK_OVERREACH = 1.35,
	-- The knob is a gem stud; the track is the same dark-glass surface the gem
	-- ProgressBar sits in. Blue because TURN is purple and DROP is red — the
	-- three controls in the row want three palettes.
	STICK_KNOB_VARIANT = "blue",
	-- The glass track is more opaque than the shared default (theme
	-- .glassTransparency): it sits over the play area, not over a panel, so it
	-- needs to hold its own shape against whatever the tower is doing behind it.
	STICK_TRACK_TRANSPARENCY = 0.45,
	STICK_TRACK_DISABLED_TRANSPARENCY = 0.75,
	-- Placement streaming: the holder's client owns the *feel* of aiming and
	-- reports where the piece is. This is how often that report goes out (the
	-- rate spectators see the piece move at) and the movement below which it
	-- isn't worth a packet.
	AIM_INTERVAL = 1 / 30,
	AIM_EPSILON = 0.05,

	-- ---------------------------------------------------------------- gamepad --
	-- The left stick steers (analog, so a gentle push nudges) as an *alternative*
	-- to the D-pad and the bumpers, never a replacement — all three stay live.
	-- The right stick isn't a piece control at all: it drives the player's cursor.
	--
	-- Below this the left stick reads as centred, and control goes back to
	-- whatever the D-pad or bumpers are doing. Generous — a resting stick that
	-- drifts would otherwise slide the piece on its own.
	GAMEPAD_STEER_DEADZONE = 0.2,

	-- ----------------------------------------------------------------- blocks --
	-- Impact sounds: below this speed a collision is a nudge, not a landing.
	IMPACT_MIN_SPEED = 12,
	-- Speed at which an impact is at full volume. Kept level with FALL_SPEED: with
	-- a terminal velocity in play nothing ever arrives faster than that, so a
	-- louder threshold would mean no landing in the game ever reached full volume
	-- and the whole range would sit muted.
	IMPACT_LOUD_SPEED = 55,
	-- One impact sound per block per this many seconds, so a piece skittering
	-- down a tower doesn't machine-gun the kit.
	IMPACT_COOLDOWN = 0.25,
	-- Rolloff for block sounds, in studs.
	SOUND_RANGE = 140,
	-- Master gain on everything a *block* makes a noise about: the landing sample,
	-- the settle, the drop, the glue weld, the bomb's beep.
	--
	-- One dial rather than re-tuning seven skin volumes and a folder of
	-- Studio-authored cues, because the two sources are tuned in different places
	-- and would drift apart the moment either was touched. It scales whatever
	-- those were tuned to, so the mix *between* blocks — a Duck against an Anvil,
	-- a gentle settle against a sixty-stud drop — survives the change.
	--
	-- Deliberately not applied to the world SFX (the storm, lightning, a
	-- checkpoint demolition, the nuke): those aren't a block being a block, and
	-- they were already the loudest things in the game.
	BLOCK_VOLUME_SCALE = 2,
	-- A second gain, on the *landing* alone: the skin's impact sample and the cue
	-- a type lands on instead (the Anvil's clang). Stacks on BLOCK_VOLUME_SCALE
	-- above, so a landing is 5x what its sample was tuned to and everything else a
	-- block does — the drop, the settle, the glue weld, the bomb's beep — stays at
	-- 2x.
	--
	-- Its own dial rather than a bigger BLOCK_VOLUME_SCALE because the landing is
	-- the game's percussion: it's the sound the whole room is listening for, it's
	-- the one with a folder of takes behind it, and it wants to sit above the
	-- noises a block makes on the way there. Applied at `playImpact` for both
	-- paths, so the mix between a squish, a plank and an anvil survives it.
	IMPACT_VOLUME_SCALE = 2.5,
	-- Bomb blocks: a hole in the tower, not the end of the run.
	--
	-- Down from 46 / 1.6M / 145, which gutted it. At that reach a bomb landing
	-- anywhere near the middle of a stack took most of what was under it as well
	-- as everything above, and the tower didn't fall over so much as cease — which
	-- left nothing to rebuild from and no read on what the player should have done
	-- differently. The radius is the blunt dial: it sets reach, and reach squares,
	-- so 36 against 46 is closer to two-thirds of the blocks touched than
	-- four-fifths.
	--
	-- Still a moment rather than a bump. It stays comfortably the biggest thing a
	-- player can be handed — a Lightning block's is 26 / 700k / 43.
	EXPLOSION_RADIUS = 36,
	EXPLOSION_PRESSURE = 1000000,
	-- Extra outward kick applied by hand to everything in radius. BlastPressure
	-- alone falls off sharply and barely moves the heavy welded assemblies, so
	-- this is what gives the blast its throw. Turn *this* one to tune how hard a
	-- bomb hits; the radius above tunes how much it reaches.
	EXPLOSION_IMPULSE = 95,
	-- The blast is the loudest thing in the game; the kit's clip on its own sits
	-- level with a block landing, which undersells it.
	EXPLOSION_VOLUME = 1.7,
	-- The Nuke product: a chain of blasts walked up the tower it just cut loose,
	-- so a nuke reads as a nuke rather than as the tower quietly disappearing.
	-- Bigger and looser than a bomb — it isn't meant to be survivable, it's
	-- meant to look like the end of the world.
	--
	-- Rungs up the tower, times blasts abreast at each rung. Both matter: the
	-- rungs are what make it climb, and the width is what makes it cover the
	-- play plane instead of one column of it.
	NUKE_BLASTS = 8,
	NUKE_BLASTS_ACROSS = 3,
	-- How far a blast may wander from its slot in the row, as a fraction of the
	-- steering limit. Enough that the barrage doesn't read as a grid, small
	-- enough that the columns still cover their own share of the plane.
	NUKE_BLAST_JITTER = 0.25,
	NUKE_BLAST_INTERVAL = 0.12,
	NUKE_RADIUS = 60,
	NUKE_PRESSURE = 2000000,
	NUKE_IMPULSE = 190,
	-- How long the wreck is left flying after the *last* blast before it's
	-- swept. Measured from the end of the chain rather than from the purchase,
	-- so a piece can't be cleaned up out of a blast that was about to throw it.
	NUKE_WRECK_SECONDS = 3.5,

	-- A bomb doesn't go off on contact — it warns first. Three beeps with the
	-- piece flashing red, which is long enough for the room to see it coming and
	-- short enough that the tower hasn't finished settling around it.
	BOMB_BEEPS = 3,
	BOMB_BEEP_ON = 0.14,
	BOMB_BEEP_OFF = 0.28,
	BOMB_FLASH_COLOR = Color3.fromRGB(255, 38, 28),
	-- Glue blocks: how far a contact can be and still get welded.
	GLUE_RADIUS = 6,
	-- …and what a block that got welded looks like afterwards. Glue is the one
	-- effect whose result is invisible — the welds are real and permanent, and
	-- until now the only way to know which blocks were in the cluster was to
	-- knock it and see what didn't move. The tint is the Glue type's own `tell`
	-- green, so the block that did it and the blocks it did it to read as one
	-- thing.
	--
	-- Fainter than the type tell it sits beside (0.65): this marks a block that
	-- *was* acted on rather than one that's about to act, and a glued neighbour
	-- shouting as loudly as the hazard itself would be the wrong ranking.
	GLUE_TELL_TRANSPARENCY = 0.8,
	GLUE_TELL_OUTLINE_TRANSPARENCY = 0.45,
	-- Clone blocks: the copy drops in this far above where the original settled,
	-- nudged sideways so it can't balance perfectly on its own parent.
	CLONE_RISE = 16,
	CLONE_OFFSET_X = 3,
	-- Bouncy blocks: elasticity replaces the dead landing of BLOCK_PHYSICS. The
	-- high elasticityWeight is what makes the bounce survive contact with the
	-- ordinary, completely inelastic blocks it lands on.
	-- (density, friction, elasticity, frictionWeight, elasticityWeight)
	BOUNCY_PHYSICS = PhysicalProperties.new(0.8, 0.35, 0.72, 1, 10),
	-- Anvil blocks: ten times the density of an ordinary block, everything else
	-- untouched. Gravity is an acceleration, so this doesn't make it *fall*
	-- faster — it makes it refuse to be pushed. It ploughs through a stack it
	-- lands on and is immovable to build against afterwards.
	ANVIL_PHYSICS = PhysicalProperties.new(8, BLOCK_FRICTION, 0, 10, 1),
	-- …and the speed lines it falls behind. One narrow Trail per cell, so a
	-- four-cell anvil draws four lines rather than one wide ribbon.
	--
	-- A Trail is exactly the right instrument here and needs no gate: it only
	-- draws while its attachments are *moving*, so the lines appear when the block
	-- is dropped, stretch with the fall, and are gone a quarter of a second after
	-- it lands. Nothing has to decide when a block counts as falling.
	ANVIL_LINE_COLOR = Color3.fromRGB(226, 232, 245),
	-- How far apart the two attachments sit, i.e. how wide one line is. Well under
	-- a cell (4 studs) — a ribbon as wide as the block reads as a smear.
	ANVIL_LINE_WIDTH = 0.5,
	-- How long a line hangs behind the block. Long enough to read as speed at
	-- FALL_SPEED (55 studs/s ≈ 11 studs of line), short enough to be gone before
	-- the landing settles.
	ANVIL_LINE_SECONDS = 0.2,
	-- Faint at the block and gone at the tail, so the lines read as motion blur
	-- rather than as ribbons tied to it.
	ANVIL_LINE_TRANSPARENCY = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	}),
	-- Anvil blocks land like anvils: their own cue, instead of the skin's impact
	-- sample. See `BlockTypes.impactCue`.
	ANVIL_IMPACT_CUE = "Anvil",
	-- What the Anchor type leaves behind. Grey, and a material that reads as cut
	-- stone at the size a cell is drawn — the block stops being whatever it rolled
	-- and becomes part of the scenery, which is what being permanently anchored
	-- makes it.
	STATUE_COLOR = Color3.fromRGB(132, 132, 138),
	STATUE_MATERIAL = Enum.Material.Slate,
	-- Ice blocks: BLOCK_PHYSICS with the friction taken out. The high
	-- frictionWeight is inherited on purpose — it's what makes the ice win the
	-- contact, so things slide *on* it rather than gripping normally.
	ICE_PHYSICS = PhysicalProperties.new(0.8, 0.02, 0, 10, 1),
	-- Feather blocks: light, so they shove nothing on the way past.
	FEATHER_PHYSICS = PhysicalProperties.new(0.2, BLOCK_FRICTION, 0, 10, 1),
	-- …and a terminal velocity, which is the actual mechanic. Density can't slow
	-- a fall (gravity is an acceleration), so the drift is a clamp on downward
	-- speed applied in the plane poll. Low enough to hand the holder several
	-- extra seconds of steering, at the cost of the same seconds off their clock.
	FEATHER_FALL_SPEED = 12,
	-- Terminal velocity for every *other* block, applied in the same plane poll.
	--
	-- A piece spawns SPAWN_CLEARANCE (14) above whatever it's going to land on, and
	-- one that misses the stack falls the height of the tower. Unclamped, gravity
	-- had already accelerated it past 65 studs/s by the time it arrived, and the
	-- tower wore every bit of that — which is what turned careful placements into
	-- avalanches.
	--
	-- 55 costs almost no *time*, which is the point: a cap only bites in the last
	-- stretch of a fall, so a drop from spawn clearance lands about 4% later while
	-- carrying a little over half the energy. Slowing the fall itself would have
	-- been the wrong trade with a turn clock running.
	--
	-- Turn it down for gentler landings still, up towards 70 to put the old punch
	-- back. Keep IMPACT_LOUD_SPEED level with it either way.
	FALL_SPEED = 55,
	-- Crate blocks: the welds are cut when it settles and the loose cells are
	-- nudged apart. In-plane only — a scatter with any Z in it would push cells
	-- out of the play plane faster than the clamp pulls them back.
	CRATE_SCATTER = 7,
	CRATE_LIFT = 4,
	CRATE_SPIN = 6,
	-- Mystery blocks: how long the revealed name hangs over the block before the
	-- plate fades. The plate has already been dismissed by the time this runs
	-- (that happens on the first settle), so the reveal puts a fresh one up.
	MYSTERY_REVEAL_SECONDS = 2.5,
	-- Burning blocks. A lit block blackens over BURN_SECONDS and then falls
	-- apart, and anything resting against it catches too — so the hazard isn't
	-- the block, it's the hole it leaves in the tower.
	BURN_SECONDS = 20,
	-- How far a contact can be and still catch. Deliberately tight: touching,
	-- not nearby.
	BURN_SPREAD_RADIUS = 1.2,
	-- Grace before a lit block can pass it on, so a burning piece doesn't ignite
	-- the whole course it lands in on the same frame.
	BURN_SPREAD_DELAY = 2.5,
	-- How many *other* blocks one fire may take, in total across the whole chain
	-- — not per block, or three neighbours each would be a tower on fire by the
	-- third hop. The piece that arrived alight isn't counted: it was always going
	-- to burn, and what this bounds is the damage it does to what was already
	-- built.
	--
	-- Uncapped, a Burning piece dropped into a well-packed tower was a fire that
	-- ate as far as blocks were touching, which on a good stack is all of them.
	-- The hazard should be a hole, not a demolition — and the tower with the most
	-- contacts is the one the room built most carefully, so the old behaviour
	-- punished good play hardest.
	BURN_MAX_SPREAD = 3,
	-- Fraction of the burn spent visibly falling apart (fading out) at the end.
	BURN_FADE_FRACTION = 0.25,
	-- Noob blocks. Slow enough to watch, jumpy enough to be a menace to whoever
	-- is trying to land a piece next to one.
	NOOB_WALK_SPEED = 8,
	NOOB_JUMP_POWER = 50,
	NOOB_JUMP_CHANCE = 0.35,
	NOOB_STEP_SECONDS = 1.6,
	-- How long the ragdoll is left lying there after it's squashed.
	NOOB_DESPAWN_SECONDS = 2.5,

	-- ----------------------------------------------------------------- magnet --
	-- The tug a Magnet gives when it settles: every loose block in reach is
	-- pulled toward it, falling off with distance the way a blast does.
	--
	-- Still tighter and weaker than a Bomb (radius 46, impulse 120) on purpose:
	-- the two are the same mechanism pointed opposite ways, and a pull as strong
	-- as the blast wouldn't gather a tower, it would collapse one inward — which
	-- is just a bomb that takes longer. This is the piece that tidies a lean, so
	-- it has to be able to lose to a well-built stack.
	--
	-- **It took three tunings, and the first two are why the third is shaped like
	-- this.** 22/26 and then 30/60, both as a single `ApplyImpulse` on settle, were
	-- invisible in play. Raising the number was the wrong lever twice, because the
	-- problem was never the number:
	--
	--   * an impulse is *one* change in velocity, and static friction erases it in
	--     about a fifth of a second — at half radius the first numbers bought a
	--     third of a cell of travel, and nothing at all for a block boxed in;
	--   * a Magnet lands on a tower that has been still for a minute, and a settled
	--     assembly is asleep. Impulses into sleeping assemblies are not something
	--     to rely on; a velocity write is what wakes one.
	--
	-- So the pull is now a *field*: an acceleration re-applied every frame for
	-- MAGNET_SECONDS, written into velocity (see `pullTick`). Friction has to be
	-- beaten continuously rather than once, which is the difference between a
	-- number on paper and a tower visibly leaning in.
	--
	-- Studs/s² at the centre, falling off to nothing at the rim. Over the window
	-- this is worth appreciably more than the old impulse — but it arrives as a
	-- lean rather than a shove, and a pull stays self-limiting in a way a blast
	-- isn't: everything it moves is moving *into* the block that pulled it.
	MAGNET_RADIUS = 36,
	MAGNET_ACCEL = 260,
	-- How long the field lives. Long enough to read as a pull and to drag a block
	-- a cell or two; short enough that the tower settles again before the next
	-- turn, which is the constraint that keeps this from being a wind.
	MAGNET_SECONDS = 0.55,
	-- A little of the pull is aimed up rather than straight at the magnet, which
	-- is what unsticks a resting block instead of grinding it into the floor it
	-- sits on. Well under a Bomb's 0.6: enough to break the grip, not enough to
	-- hand the room free height for landing one piece — and the tug is inward, so
	-- what a lifted block does next is fall back in, not stay up.
	MAGNET_LIFT = 0.2,

	-- -------------------------------------------------------------- sacrifice --
	-- How far under a Sacrifice block's cells it looks for what it's resting on
	-- (`blockUnder`), measured from each cell's underside. Only the Mystery reveal
	-- reads this now — a piece dealt as a Sacrifice takes the block it hit — and
	-- it stays short for the reason it always was: a generous reach would let a
	-- piece bridging a gap reach down through the gap for a block it never
	-- touched.
	SACRIFICE_REACH = 1.5,
	-- Its own cue (`Assets.Sounds.Sacrifice`), scaled 2.5x from the 0.6 it opened
	-- at. That number was set against the *explosion* this used to borrow, and a
	-- borrowed blast is a loud sample to be quiet with; the dedicated cue is a
	-- softer recording, so the same restraint left it inaudible under a landing.
	--
	-- Still a shade under a Bomb's 1.7, which is the ranking that matters: a block
	-- being unmade is a smaller event than a detonation, and the piece that did it
	-- is still falling into the hole it made.
	SACRIFICE_VOLUME = 1.5,
	-- The send-off: how long the block that was taken spends glowing, drifting and
	-- fading before it's gone. Long enough to read as *that one, there* from
	-- across the arena, short enough that it's over before the sacrifice itself
	-- has finished falling into the space.
	SACRIFICE_FADE_SECONDS = 1.1,
	-- How long the flash to SACRIFICE_GLOW takes. Fast, because it's the part that
	-- says which block went, and a slow glow would still be arriving by the time
	-- the fade had started taking it away.
	SACRIFICE_FLASH_SECONDS = 0.12,
	-- Fraction of the fade spent at full opacity before it starts going. Without
	-- the hold the block is half gone by the time anyone has looked at it.
	SACRIFICE_HOLD = 0.25,
	-- Drift, in studs per second: up, and away from the block that took it. Slow
	-- on purpose — this is a block being *spent*, and a corpse that shoots off
	-- reads as an explosion, which is the one thing a sacrifice isn't.
	SACRIFICE_RISE = 5,
	SACRIFICE_DRIFT = 2.5,
	-- Tumble, in radians per second, about Z. A quarter turn over the whole fade:
	-- enough to say the block has come loose from the tower, not enough to spin.
	SACRIFICE_SPIN = 1.4,
	-- What it glows on the way out. The Sacrifice type's own tell colour, so the
	-- block that goes is wearing the colour of the piece that took it.
	SACRIFICE_GLOW = Color3.fromRGB(236, 108, 200),
	-- What the drifting copy is called in the arena. Named rather than left
	-- wearing the dead block's name so anything looking at the tree — a Studio
	-- explorer, the next person debugging a height that won't settle — can tell a
	-- block from a picture of one at a glance.
	SACRIFICE_CORPSE_NAME = "SacrificedBlock",

	-- ------------------------------------------------------------------ ghost --
	-- How long a Ghost falls through the tower before it turns solid. Long enough
	-- to clear a couple of floors from the spawn height, short enough that the
	-- player is still watching the piece they dropped.
	GHOST_SECONDS = 1.2,
	-- How see-through it is while it's phasing. It has to read as *not solid yet*
	-- from across the arena, since everyone else is watching it pass through the
	-- tower they built.
	GHOST_TRANSPARENCY = 0.55,
	-- Collision groups. A ghost ignores blocks and nothing else: it still lands
	-- on the base and on checkpoint platforms, because a piece that fell through
	-- the floor would be a lost turn rather than a clever one.
	BLOCK_COLLISION_GROUP = "TowerBlock",
	GHOST_COLLISION_GROUP = "TowerGhost",

	-- ------------------------------------------------------------------ zones --
	-- Studio-authored asset folders (Rojo doesn't sync these; see docs).
	ASSETS_FOLDER = "Assets",
	-- Snowy: friction drops through the floor, everything slides.
	SNOWY_PHYSICS = PhysicalProperties.new(0.8, 0.05, 0, 1, 1),
	-- Stormy: lightning strikes a settled block and detonates on it. Deliberately
	-- smaller than a Bomb — a bomb is a piece the players were handed and can
	-- plan around, while this arrives unasked, so it takes a bite out of the
	-- tower rather than gutting it.
	LIGHTNING_RADIUS = 26,
	LIGHTNING_PRESSURE = 700000,
	-- Halved from 85. The impulse is the strike's whole bite: `blastAt` throws
	-- everything in radius by hand because BlastPressure barely moves a welded
	-- assembly, so this number *is* how hard the tower is hit and halving it
	-- halves the damage.
	--
	-- The radius is the other dial and a much blunter one — it sets reach, so
	-- halving it would leave a fifth of the blocks touched, not half. Change this
	-- one to tune how hard, that one to tune how wide.
	LIGHTNING_IMPULSE = 43,
	LIGHTNING_VOLUME = 1.4,
	-- Seconds between strikes, rolled fresh in this band each time so the beats
	-- can't be counted and waited out. Measured from the previous strike, so the
	-- warning below sits *inside* the gap rather than adding to it.
	LIGHTNING_MIN_SECONDS = 14,
	LIGHTNING_MAX_SECONDS = 22,
	-- How long the red marker sits on the spot before the bolt lands. The whole
	-- point of the hazard: the strike is announced, so it costs you a tower only
	-- if you keep building into it.
	LIGHTNING_WARNING_SECONDS = 10,
	-- Attribute the server stamps on the arena with the strike position. Clients
	-- draw the bolt off it; attributes replicate, so the flash needs no packet.
	STRIKE_ATTRIBUTE = "LightningAt",
	-- Where the next bolt will land, or nil while none is pending. Just the X on
	-- the play plane: the marker is a column, and what altitude it stands at is
	-- the client's business — it has to sit on the floor the run is currently
	-- building from, which moves every checkpoint (see TowerZoneController).
	WARN_ATTRIBUTE = "LightningWarnAt",
	-- The marker: a translucent blue column standing on the doomed spot. Blue to
	-- match the bolt it announces.
	WARN_COLOR = Color3.fromRGB(64, 132, 255),
	WARN_WIDTH = 9,
	WARN_HEIGHT = 400,
	WARN_TRANSPARENCY = 0.72,
	-- How fast it pulses, in full cycles per second. Slow enough to read as a
	-- warning rather than as a strobe.
	WARN_PULSE_HZ = 1.6,
	-- The bolt itself, drawn client-side: a thin bright beam from high above the
	-- struck point down onto it, gone almost immediately.
	LIGHTNING_BOLT_WIDTH = 1.6,
	LIGHTNING_BOLT_HEIGHT = 220,
	LIGHTNING_BOLT_SECONDS = 0.16,
	-- Displacement passes for the gameplay bolt, against BOLT_PASSES for the
	-- background ones. Fewer, because this one lands a few dozen studs from the
	-- camera: the same four passes that read as forks at 900 studs read as a
	-- scribble at 40.
	LIGHTNING_BOLT_PASSES = 3,
	LIGHTNING_BOLT_COLOR = Color3.fromRGB(214, 232, 255),

	-- ------------------------------------------------------ the storm approach --
	-- The last minute before the storm, dressed. Everything below ramps 0 → 1 over
	-- this window and back to 0 the moment a new stage's clock starts: the sky
	-- darkens and thickens, the ambience comes up out of nothing, and lightning
	-- starts going off behind the tower.
	--
	-- A minute because that's about two turns' warning at the shipped clock — long
	-- enough to change what you're building for, short enough that the rest of the
	-- stage is calm. The whole thing is *presentation*: none of it touches the
	-- storm's own clock or damage, and a client that failed to draw any of it
	-- would play the identical game.
	STORM_APPROACH_SECONDS = 60,
	-- How fast the dressing chases its target. Rising, the ramp is already gradual
	-- and this barely shows; what it's really for is the fall — the storm lands,
	-- the clock restarts, and without smoothing the sky would snap back to clear
	-- on a single frame.
	STORM_APPROACH_SMOOTHING = 1.6,

	-- The looping ambience, a Studio-authored Sound cloned by name. Silent at ramp
	-- 0 by construction: volume *is* the ramp, so it can't be heard before the
	-- window opens.
	STORM_AMBIENCE_CUE = "StormAmbience",
	-- Multiplies the Volume the Sound was tuned with in Studio, at full ramp. The
	-- cue is tuned at 0.5, so this lands it at 2 — a storm arriving over the top of
	-- a tower being built is meant to be the loudest thing in the room by the time
	-- it gets there, and at 1x it was politely underneath the blocks.
	STORM_AMBIENCE_VOLUME = 4,

	-- Terrain clouds, created client-side if the place has none. Cover is how much
	-- of the sky they take, Density how solid they read; both ramp with the storm.
	-- The calm end is deliberately a *little* cloud rather than none — a sky that
	-- grows its first cloud from nothing reads as a bug, one that thickens reads
	-- as weather.
	-- Density opens at a quarter rather than at 0.03: at three hundredths the layer
	-- is mathematically present and visually nothing, so the first half of the
	-- approach looked like a bug rather than like weather gathering.
	CLOUD_COVER_CALM = 0.4,
	CLOUD_COVER_STORM = 1,
	CLOUD_DENSITY_CALM = 0.25,
	CLOUD_DENSITY_STORM = 1,
	CLOUD_COLOR_CALM = Color3.fromRGB(255, 255, 255),
	CLOUD_COLOR_STORM = Color3.fromRGB(96, 102, 120),

	-- Background lightning: pure VFX, far behind the play plane, from the storm
	-- that's coming rather than from the Stormy zone's hazard. It hits nothing and
	-- means nothing — the tell for a strike that *does* is the red column, and
	-- these are deliberately somewhere the tower can never be.
	--
	-- Seconds between strikes, rolled fresh each time. The gap is interpolated
	-- from the calm pair to the storm pair as the ramp climbs, so the first bolts
	-- are lonely and the last minute ends in a barrage.
	BG_LIGHTNING_CALM_GAP = { 7, 12 },
	BG_LIGHTNING_STORM_GAP = { 0.9, 2.6 },
	-- Below this much ramp nothing strikes at all: the window has to open on
	-- silence and a clear sky, or there's nothing for it to build from.
	BG_LIGHTNING_START_RAMP = 0.12,
	-- Where they happen. Well behind the play plane (the camera stands at +78 and
	-- nothing may sit between +6 and +420, so *negative* Z is the free half of the
	-- world) and wide enough that they aren't all in the same place.
	BG_LIGHTNING_Z = { -900, -420 },
	BG_LIGHTNING_X = { -520, 520 },
	-- Height is measured **from the camera**, not from the world floor. A fixed
	-- band worked for the first stage and then sank out of frame for the rest of
	-- the run: the tower climbs hundreds of studs, the camera climbs with it, and
	-- bolts pinned to the sky over the base end up under the player's feet. These
	-- are offsets above and below wherever the camera is now, so a strike is in
	-- shot at any altitude.
	--
	-- Between 440 and 1040 studs tall as a result — much taller than the fixed
	-- band they replace, which is the other half of being visible from up there.
	BG_LIGHTNING_ABOVE = { 260, 620 },
	BG_LIGHTNING_BELOW = { 180, 420 },
	-- How wide a background bolt's trunk is. Fat, because it's up to 900 studs
	-- away: at that distance the shipped 1.6-stud gameplay bolt is a hairline.
	BG_LIGHTNING_WIDTH = 9,
	-- Two or three at once, sometimes. A single stroke reads as a prop; a cluster
	-- reads as a storm.
	BG_LIGHTNING_FORKS = { 1, 3 },
	-- The thunder. The Stormy zone's own strike cue, played flat (2D) rather than
	-- positionally: these happen 400 to 900 studs away and a positional Sound at
	-- that range is silence, but the *point* is that the storm is audible from
	-- where the player is standing.
	--
	-- One clap per strike, not per fork — three overlapping copies of the same
	-- sample is a stutter rather than a thunderclap.
	BG_LIGHTNING_CUE = "Lightning",
	-- Multiplies the cue's own tuning, and is itself scaled by the ramp: the first
	-- bolts of the approach rumble, the last ones crack.
	BG_LIGHTNING_VOLUME = 1.4,
	-- How much quieter the far end of the band is than the near end. Distance is
	-- the only thing separating these bolts from each other, so it's worth hearing.
	BG_LIGHTNING_FAR_QUIET = 0.45,
	-- Studs per second, for the gap between the flash and the clap. Roughly the
	-- real speed of sound at this game's scale — the delay is small (about half a
	-- second at 600 studs) and it is the single detail that makes a bolt read as
	-- *far away* rather than as a sound effect that fired late.
	BG_LIGHTNING_SOUND_SPEED = 1120,

	-- --------------------------------------------------------- the bolt shape --
	-- How a bolt is built, for both the background VFX and the Stormy zone's own
	-- strike. Midpoint displacement: start with a straight line, then split every
	-- segment and shove the new middle sideways, halving the shove each pass — the
	-- standard way to draw lightning, and the reason it reads as a bolt rather
	-- than as a crack.
	--
	-- Four passes is 16 segments, which is where the shape stops improving and the
	-- part count keeps climbing.
	BOLT_PASSES = 4,
	-- The first pass's sideways shove, as a fraction of the bolt's length. Halved
	-- every pass after it.
	BOLT_JITTER = 0.14,
	-- Chance a node grows a branch, and how much of the parent's remaining run a
	-- branch covers. Branches get one pass fewer and two thirds the width, and
	-- they don't branch again — a fractal that recurses to the leaves is a tree,
	-- and lightning is a bolt with a few forks off it.
	BOLT_BRANCH_CHANCE = 0.22,
	BOLT_BRANCH_LENGTH = { 0.25, 0.55 },
	BOLT_BRANCH_WIDTH = 0.62,
	-- How far a branch leans off its parent's heading, in degrees.
	BOLT_BRANCH_SPREAD = { 18, 46 },
	-- How long the whole thing hangs before it's gone. Two beats: the flash sits
	-- at full brightness for the first, then fades over the second, which is what
	-- makes it read as a strike rather than as a fading line.
	BOLT_HOLD_SECONDS = 0.06,
	BOLT_FADE_SECONDS = 0.22,

	-- Foggy: the arena fades out with distance. The camera stands ~78 studs back,
	-- so the far end has to start well inside that or the fog does nothing.
	FOG_START = 20,
	FOG_END = 150,
	FOG_COLOR = Color3.fromRGB(198, 202, 210),

	-- Night: the world goes dark and every block carries its own light, so the
	-- tower lights itself and the players build by what they've already placed.
	NIGHT_BRIGHTNESS = 0.6,
	NIGHT_AMBIENT = Color3.fromRGB(28, 30, 48),
	NIGHT_CLOCK_TIME = 0,
	-- One PointLight per *block*, not per cell — a light on all four cells of a
	-- tetromino is four times the cost for no visible gain.
	NIGHT_LIGHT_RANGE = 17,
	NIGHT_LIGHT_BRIGHTNESS = 1.5,

	-- How long the "special zone" banner stays up.
	ZONE_WARNING_SECONDS = 4.5,
	-- Height above the tower top that weather effects are parented at, so the
	-- particles fall through the play area rather than starting inside it.
	WEATHER_HEIGHT = 90,

	-- ------------------------------------------------------------------- cash --
	CASH_PER_ZONE = 50,
	-- Paid to whoever placed the block, per stud the tower's record grew by.
	-- Rewards the player who actually pushed it higher rather than the room.
	CASH_PER_STUD = 2,
	CASH_PER_INTERVAL = 10,
	CASH_INTERVAL_SECONDS = 300,
	-- The counter itself. Here rather than in `CashCounter` because both HUDs
	-- need the height to stack their camera toggle above it, and the classic
	-- progress rail needs it to know where to stop — a component that owned the
	-- number would have to be required for a layout constant.
	CASH_WIDTH = 205,
	CASH_HEIGHT = 58,
	-- How many bills fly to the counter per award, and how long they take.
	CASH_FLY_COUNT = 12,
	CASH_FLY_SECONDS = 0.75,
	CASH_IMAGE = "rbxassetid://73395222638222",
	-- The Extend Storm button's icon. A game asset rather than a kit icon, so it
	-- lives here beside CASH_IMAGE instead of in `Boil.assets.Icons` — the
	-- shared registry is the framework's, and the framework names no feature.
	EXTEND_STORM_ICON = "rbxassetid://81007673236910",

	-- ------------------------------------------------------------------ hud --
	-- Headshot strip: the current player sits dead center at the larger size,
	-- everyone else shrinks and fades out either side of them.
	AVATAR_SIZE = 64,
	AVATAR_SIZE_INACTIVE = 44,
	AVATAR_SPACING = 58,
	AVATAR_FADE_INACTIVE = 0.45,
	-- Cap on how many players the strip draws (centered on the current one).
	AVATAR_MAX_SHOWN = 7,
	-- The controls hint shows for this long, then fades out over its own tween.
	HINT_SECONDS = 60,
	HINT_FADE_SECONDS = 1.5,

	-- ---------------------------------------------------------------- storm --
	-- The pressure mechanic: reach the target height before the clock runs out
	-- and the tower gains a permanent floor to build on. Miss it and the storm
	-- takes the whole tower — see STORM_BLAST_* below.
	--
	-- Clearing a stage also *wipes the blocks below the new platform* — the
	-- checkpoint becomes a clean foundation hanging in the air, which is what
	-- keeps a long session from dragging a thousand physics parts behind it.
	-- The first stage's clock. Later stages get STORM_TIME_GROWTH more each.
	STORM_SECONDS = 300,
	-- Every cleared stage adds this much to the stage clock, so the climb and the
	-- time to make it grow together: 300, then 305, then 310…
	--
	-- Paired with STORM_GAP_GROWTH deliberately. A gap that grows against a fixed
	-- clock makes every stage strictly harder than the last, and the run ends at
	-- whatever height that curve happens to cross — extending the clock alongside
	-- it means a later stage asks for a longer climb rather than a faster one.
	STORM_TIME_GROWTH = 5,
	-- Distance to the first checkpoint, in studs above the base.
	--
	-- Read this against the turn budget, not on its own: a stage is about 18
	-- turns (STORM_SECONDS / (TURN_SECONDS + SETTLE_SECONDS)) and a flat piece
	-- adds BLOCK_SIZE studs. At 60 the room needed ~15 of its ~18 turns to gain
	-- full height — a three-turn margin for every piece that slides off, every
	-- overhang and every player who wasn't looking — and the onboarding funnel
	-- lost three quarters of its players at the first checkpoint. 40 is ten
	-- clean placements, which a room of strangers can miss a few times and
	-- still make.
	STORM_FIRST_TARGET = 40,
	-- Every cleared stage puts the next checkpoint this much further out than
	-- the last gap: 40, then 45, then 50…
	--
	-- Five studs is a little over one clean placement, and it's the same slope
	-- the targets had before STORM_FIRST_TARGET was cut — so the curve runs
	-- parallel to the old one (60, 65, 70…), a permanent 20 studs below it,
	-- rather than climbing back up to meet it a few checkpoints in.
	STORM_GAP_GROWTH = 5,
	-- When the clock runs out the tower is thrown apart rather than quietly
	-- deleted — and it goes one way: **left**, like a gust taking it off the
	-- screen. A random scatter read as an explosion under the tower, which is the
	-- Bomb's language and the demolition's; the storm is weather, and weather
	-- comes *from* somewhere.
	--
	-- The sideways number is the gust and is the big one; the lift is what stops
	-- the wreck from ploughing along the floor, and the jitter on each keeps the
	-- pieces from moving as one sheet.
	STORM_BLAST_HORIZONTAL = 130,
	STORM_BLAST_HORIZONTAL_JITTER = 45,
	STORM_BLAST_UP = 34,
	STORM_BLAST_SPIN = 12,
	-- A little depth, so the wreck doesn't stay a flat cut-out on the play plane —
	-- but far less than it had, because it's being blown off the board now rather
	-- than scattered in place.
	STORM_BLAST_DEPTH = 18,
	-- How long the debris is left flying before it's cleared and the run resets.
	STORM_BLAST_SECONDS = 2.5,
	-- The storm announces itself before it arrives: the camera starts shaking
	-- this many seconds out and builds until it hits. Client-side (the camera is
	-- a presentation), driven off the same `stormEndsAt` the clock reads, so
	-- nothing extra goes over the wire for it.
	STORM_SHAKE_LEAD_SECONDS = 30,
	-- Peak jitter at the moment the storm lands: studs of positional shake, and
	-- degrees of roll. Small numbers — the camera is close to the tower, so a
	-- stud reads as a lot more movement than it sounds like.
	STORM_SHAKE_OFFSET = 1.1,
	STORM_SHAKE_TILT_DEGREES = 0.7,
	-- How fast the shake oscillates. Sampled from math.noise rather than random
	-- per frame, so it reads as rumble rather than static.
	STORM_SHAKE_FREQUENCY = 17,
	-- The white-out when the storm takes the tower. The delay is what lets the
	-- players actually see the wreck fly before the screen goes: blocks first,
	-- then white, then it clears onto the empty arena and the vote.
	--
	-- Raised from 0.8 with the blast: at 130 studs/s leftward the tower needs
	-- about a second and a half to clear a frame roughly 160 studs wide, and a
	-- white-out that started before it had left was covering the shot it exists to
	-- give the players. The order is the whole ask — blocks *then* fade.
	STORM_FADE_DELAY_SECONDS = 1.7,
	STORM_FADE_IN_SECONDS = 1.2,
	-- How long full white is held before it starts clearing.
	STORM_FADE_HOLD_SECONDS = 0.5,
	STORM_FADE_OUT_SECONDS = 1.3,
	-- Checkpoint platform entrance: stretches out from a sliver, glowing white,
	-- then cools to black.
	PLATFORM_GROW_SECONDS = 0.45,
	PLATFORM_FADE_SECONDS = 1.1,
	PLATFORM_SPAWN_COLOR = Color3.fromRGB(255, 255, 255),
	PLATFORM_SETTLED_COLOR = Color3.fromRGB(12, 12, 16),

	-- ----------------------------------------------------------- checkpoints --
	-- Clearing a stage isn't a number going up, it's a cutscene: play stops, the
	-- camera pulls back far enough to show the whole leg the players just built,
	-- the scaffolding under the new floor is blown apart, and then the camera
	-- comes back and the next turn starts. The server drives the beats; the
	-- camera follows PHASE.CHECKPOINT and needs no cue of its own.
	--
	-- Total pause is the sum of these four, plus PLATFORM_GROW_SECONDS.
	CHECKPOINT_PAUSE_SECONDS = 0.7,
	-- The wide shot is held this long before anything blows up, so the tower gets
	-- a moment of being looked at.
	CHECKPOINT_VIEW_SECONDS = 1.5,
	-- How long the debris flies before it's cleared.
	CHECKPOINT_BLAST_SECONDS = 2,
	-- Beat after the dust settles before the queue picks back up.
	CHECKPOINT_RESUME_SECONDS = 0.8,
	-- How hard the old tower is thrown. Softer than the storm's blast: this one
	-- is a demolition, not a punishment.
	CHECKPOINT_BLAST_HORIZONTAL = 65,
	CHECKPOINT_BLAST_UP = 45,
	CHECKPOINT_BLAST_SPIN = 9,

	-- --------------------------------------------------------- the round break --
	-- The storm taking the tower ends the *round*, and the round break is the
	-- pause that follows: the wreck flies, the screen goes white, the players vote
	-- on how the next round plays, and then a fresh run starts on those numbers.
	--
	-- Everything is parked for the whole of it — the turn queue, the storm clock,
	-- and the height poll — so the vote isn't a thing happening *over* a game
	-- that's still running underneath it.
	--
	-- How long the wreck is left to fly before the vote opens over it. Long enough
	-- to read as a consequence; the blast itself is STORM_BLAST_SECONDS.
	-- Long enough to contain the whole send-off before a UI opens over it: the
	-- gust (STORM_FADE_DELAY_SECONDS) plus the fade to white (STORM_FADE_IN).
	ROUND_BREAK_WRECK_SECONDS = 3.2,
	-- Beat after the vote closes before the first piece of the new round appears,
	-- so the fade back in has somewhere to land.
	ROUND_BREAK_RESUME_SECONDS = 1,
	-- The session's first round is voted for too (`runOpeningVote`). This is the
	-- beat between the first player arriving and the ballot opening on them:
	-- enough for their client to mount its UI, so the vote doesn't open behind a
	-- loading screen and spend its own clock there. Longer than the round break's
	-- equivalents because a joining client has a whole tree to build, where a
	-- mid-session one has had it up for minutes.
	OPENING_VOTE_DELAY = 2.5,

	-- --------------------------------------------------------------- physics --
	-- Grippy and dead: high friction so a stack doesn't slide itself apart, zero
	-- elasticity so a dropped piece lands instead of bouncing off the tower.
	-- (density, friction, elasticity, frictionWeight, elasticityWeight)
	BLOCK_PHYSICS = PhysicalProperties.new(0.8, BLOCK_FRICTION, 0, 10, 1),
	-- What the *ground* is made of: the arena base, every checkpoint platform, and
	-- every PVP lane platform. Identical to BLOCK_PHYSICS except that both weights
	-- are pinned at the maximum, which is the whole point.
	--
	-- Roblox blends a contact as `(v1 * w1 + v2 * w2) / (w1 + w2)`, so a weight is
	-- a claim about which of the two surfaces decides. The physics block types
	-- carry high weights on purpose — Bouncy's elasticityWeight of 10 is what makes
	-- its bounce survive contact with the dead, inelastic blocks it lands on, and
	-- Ice's frictionWeight of 10 is what makes things slide *on* it. Against a
	-- floor sharing BLOCK_PHYSICS's weights those claims won outright: a Bouncy
	-- block met the bare ground at 0.65 elasticity and a Ice one at 0.46 friction,
	-- so the floor itself read as bouncy and slippery.
	--
	-- Which nobody wants, and PVP is where it showed: a lane starts empty and stays
	-- short, so a large share of every match's pieces land on bare platform rather
	-- than on a tower. Classic hid it behind one tall shared tower.
	--
	-- At weight 100 the floor wins its own contacts and the types keep their whole
	-- mechanic, because a type's weight is only ever pitted against *blocks* now:
	--
	--   Bouncy on the floor   0.65 -> 0.07 elasticity   (dead, as ground should be)
	--   Bouncy on a block     0.65 -> 0.65              (unchanged — the mechanic)
	--   Ice on the floor      0.46 -> 0.82 friction     (grips, as ground should)
	--   A block on the Ice    0.46 -> 0.46              (unchanged — the mechanic)
	--   Anything else         0.90 -> 0.90 friction     (unchanged)
	FLOOR_PHYSICS = PhysicalProperties.new(0.8, BLOCK_FRICTION, 0, 100, 100),
	-- A block is a candidate for "settled" once its assembly is this slow and
	-- this close to not spinning.
	SETTLED_SPEED = 0.6,
	SETTLED_SPIN = 0.6,
	-- …but it only *counts* once it has stayed that slow for this long. Without
	-- the hold, a block thrown up by a bomb is momentarily motionless at the top
	-- of its arc, and a block that is briefly motionless in mid-air was enough to
	-- hand the players a checkpoint they hadn't built to. Anything above these
	-- speeds knocks a settled block back out of the count.
	SETTLE_CONFIRM_SECONDS = 0.45,
	UNSETTLE_SPEED = 2.5,
	UNSETTLE_SPIN = 2,
	-- Blocks that fall this far below the base top are cleaned up. Pieces only
	-- ever spawn *above* the tower, so anything under the platform has fallen off
	-- the side — and if the place has a baseplate it would otherwise sit there
	-- forever instead of falling out of the world.
	DESPAWN_BELOW = 20,
	-- How far off the plane a block may sit before it's nudged back. Tight: a
	-- collision can throw a block this far in a single physics step, and at
	-- BLOCK_DEPTH 4 even a fraction of a stud is visible as the tower losing its
	-- flat silhouette. Measured at ~0.39 with this at 0.25.
	PLANE_TOLERANCE = 0.08,
	-- How far a block may be *tilted* out of the plane before it's straightened,
	-- measured as `1 - |LookVector.Z|` (0 = perfectly face-on, 1 = edge-on).
	--
	-- Clamping angular velocity stops a block tipping any *further*, but never
	-- undoes a tilt it already has — and a blast can impart most of a tumble
	-- inside a single physics step, before the next clamp runs. Without this,
	-- blocks come to rest skewed and stay skewed, which is what makes the tower
	-- read as 3D.
	PLANE_TILT_TOLERANCE = 0.002,
	-- How fast a moving block is rotated back into plane, as an exponential rate.
	-- Gentle: snapping a piece mid-flight looks like it teleported, so it eases
	-- while it travels and is snapped outright once it's resting.
	PLANE_STRAIGHTEN_RATE = 9,
	-- Below this a block counts as resting, and gets straightened in one step
	-- rather than eased.
	PLANE_RESTING_SPEED = 0.05,

	-- --------------------------------------------------------------- tempo --
	-- Height recompute + state broadcast interval, seconds.
	POLL_INTERVAL = 0.2,
	-- Height change that's worth a broadcast, studs.
	HEIGHT_EPSILON = 0.05,

	-- --------------------------------------------------------------- camera --
	-- Stationary framing: the camera never orbits, it only rides the altitude of
	-- the tower's highest point.
	CAMERA_DISTANCE = 78,
	-- The camera looks dead level at a point this far above the tower top, which
	-- puts the tower and the piece waiting at SPAWN_CLEARANCE both in frame.
	CAMERA_AIM_LIFT = 10,
	-- Phone framing. A phone held upright has far less vertical room than a
	-- monitor, so the desktop lift put the tower top near the middle of the
	-- screen and everything the player had built ran off the bottom — it read as
	-- the camera sitting too high. Aiming lower and standing further back gives
	-- the stack back without losing the piece waiting overhead.
	CAMERA_AIM_LIFT_TOUCH = 1,
	CAMERA_DISTANCE_TOUCH = 94,
	-- Minimum altitude the camera frames, so an empty base isn't at the top edge.
	CAMERA_MIN_HEIGHT = 14,
	-- Exponential follow rate (higher = snappier).
	CAMERA_LERP = 4,
	-- The checkpoint pull-back is a camera move the player is meant to watch, so
	-- it eases rather than tracks.
	CAMERA_CHECKPOINT_LERP = 1.6,
	-- Headroom either side of the tower in the checkpoint wide shot, in studs.
	CAMERA_CHECKPOINT_PADDING = 34,
	-- Floor on the pull-back, as a multiple of the normal shot's distance. A
	-- short leg already fits in the ordinary framing, so fitting it is not enough
	-- — the move has to *read* as stepping back to look at what was built.
	CAMERA_CHECKPOINT_PULLBACK = 1.6,
	-- Air around the tower in the HUD button's overview shot. Bigger than the
	-- checkpoint's padding because this frames the *whole* tower, and a stack
	-- pressed against both edges of the screen reads as clipped rather than as
	-- pulled back.
	CAMERA_OVERVIEW_PADDING = 52,
	-- Ceiling on the pull-back, so a monstrous leg doesn't put the camera in
	-- orbit and the tower in one pixel.
	CAMERA_MAX_DISTANCE = 420,
	CAMERA_FOV = 60,
	-- Headroom left above the held piece when the camera has to stretch upward to
	-- keep it in frame. The piece always clears the tower (SPAWN_CLEARANCE), so
	-- the camera has to be willing to follow it up there.
	CAMERA_PIECE_MARGIN = 6,
	-- Half the width of the play area the camera must always show, in studs: the
	-- steering limit (22) plus a piece's own half width (8), plus a little air.
	-- Roblox's FieldOfView is *vertical*, so a phone held upright frames the same
	-- height as a monitor and far less width — the camera reads the real viewport
	-- aspect and stands back far enough to cover this on whatever screen it's on.
	CAMERA_MIN_HALF_WIDTH = 34,

	-- ----------------------------------------------------------------- store --
	-- Developer products, configured on the Roblox place. Ids are the live ones
	-- — a product id can't be invented locally, so these are the numbers or the
	-- purchase prompt errors.
	--
	-- The cash bundles are granted generically by StoreService (grant `amount`
	-- of `currency`); the two action products run handlers registered by
	-- TowerProductsService.
	PRODUCTS = {
		CASH_500 = 3707809246,
		CASH_1000 = 3707809250,
		CASH_10000 = 3707809258,
		-- Cuts the standing tower loose and detonates it. The run itself carries
		-- on — same checkpoints, same clock, same stage — so what it costs the
		-- room is the climb above the last floor rather than the round.
		NUKE = 3707809217,
		-- Jumps the tower up to the target height and clears the stage there,
		-- cutscene and all — buys the climb, not just a floor wherever play
		-- happened to stop.
		NEXT_CHECKPOINT = 3707809233,
		-- Puts EXTEND_STORM_SECONDS back on the stage clock, for the whole room.
		-- Bought from the HUD rather than the shop — the button sits beside the
		-- clock it buys.
		EXTEND_STORM = 3708160736,
	},
	-- How much time one Extend Storm purchase buys. A fifth of a stage
	-- (STORM_SECONDS is 300): enough to finish a leg that was going to fall
	-- just short, not enough to make the clock stop mattering. Stacks — two
	-- purchases are two minutes.
	EXTEND_STORM_SECONDS = 60,
	-- Where the "X bought Nuke!" announcements go. The default general channel:
	-- all three products change the game for everyone in the server, so the
	-- notice belongs in the one channel everyone is already reading.
	ANNOUNCE_CHANNEL = "RBXGeneral",
	-- The buyer's name in that line, as a rich-text colour. Gold, because the
	-- line is about a Robux purchase and the chat around it is white.
	ANNOUNCE_NAME_COLOR = "#ffd75e",
	-- Gamepasses, also configured on the place. Ownership is Roblox's answer;
	-- StoreService caches it per session and this feature reads it through
	-- `StoreService.ownsGamepass` on the server. Never trust a client for either.
	GAMEPASSES = {
		-- Multiplies everything CashService pays out.
		DOUBLE_CASH = 1949354348,
		-- Hands the owner the next piece as well as this one.
		DOUBLE_TURN = 1951016323,
	},
	-- What "2x Cash" multiplies earnings by. Applied in CashService.award — the
	-- one path everything the game *pays* goes through. Robux coin bundles are a
	-- purchase rather than earnings, so they're granted at face value.
	DOUBLE_CASH_MULTIPLIER = 2,
	-- How many turns in a row a Double Turn owner takes.
	DOUBLE_TURN_TURNS = 2,
	-- The soft currency id this feature registers with the Store. Its balance
	-- lives at { PROFILE_KEY, "Cash" } — Store debits it through that path.
	CURRENCY_ID = "coins",

	-- The Needoh pack. Priced above Neon because it's the one pack that changes
	-- what a landing *sounds* like, and because it's the daily run's grand prize
	-- — a week of claims has to be worth more than an afternoon of coins.
	NEEDOH_SKIN_PRICE = 250,

	-- ------------------------------------------------------- colour skin packs --
	-- The ten colour packs all cost the same: they're the same product in ten
	-- flavours, and pricing one above another would only be telling players their
	-- favourite colour is worth less.
	COLOR_SKIN_PRICE = 60,
	-- Defaults for the roll each block makes (see SkinPacks.colorFor). The bright
	-- packs use these; the neutrals override them.
	COLOR_SKIN_SATURATION = 0.78,
	COLOR_SKIN_SATURATION_JITTER = 0.18,
	COLOR_SKIN_VALUE = 0.82,
	COLOR_SKIN_VALUE_JITTER = 0.2,
	-- Hue wanders far less than saturation or value: past a narrow band a "red"
	-- pack starts handing out oranges and stops being what the card promised.
	COLOR_SKIN_HUE_JITTER = 0.02,

	-- ------------------------------------------------------------- duck blocks --
	-- A personal skin, not a product. It is never rolled (BlockSkins gives it
	-- weight 0) and never sold (`forSale = false` in SkinPacks), so the grant in
	-- DuckSkinService is the only way anyone has it — which is what makes the list
	-- below the whole access-control story for it.
	DUCK_PACK = "skins.duck",
	-- Who gets it, by exact Roblox username, matched case-insensitively.
	--
	-- Usernames rather than UserIds for the same reason Cmdr's allow-list uses
	-- them: they're the thing a human editing this file actually knows. Same
	-- caveat too — a name change hands the skin to whoever picks the old name up.
	-- This is a cosmetic, so that's an acceptable trade here in a way it wouldn't
	-- be for admin access; swap both lists to UserIds together if it ever stops
	-- being one.
	DUCK_OWNERS = {
		"realaverageant",
		"Banana_Fudge0",
	},

	-- --------------------------------------------------- first-checkpoint quest --
	-- The retention hook for a brand-new player. Reaching the first checkpoint is
	-- where most of them stop playing, and the climb up to it promised nothing but
	-- coins they had no use for yet — so the HUD names a prize instead, and
	-- clearing one hands it over (CheckpointQuestService).
	--
	-- The pack is `forSale = false` in SkinPacks, so this quest is the *only* way
	-- to get it. That's what makes the line's "RARE" true rather than marketing: a
	-- prize also sitting in the shop for 60 coins is not a prize.
	FIRST_CHECKPOINT_PACK = "skins.gold",
	-- How long the quest line holds its claimed state before retiring for good.
	-- Long enough to read through the checkpoint cutscene, which is what the
	-- player is watching when it fires.
	-- How long the *promise* line stays up — "get to the next checkpoint for a rare
	-- skin". It used to be a standing line in the HUD's top column, which is where
	-- the storm clock now lives; and a permanent call to action was the wrong shape
	-- for it anyway. It's news the first time a player sees it and furniture by the
	-- tenth, so it announces itself once and gets out of the way. Six seconds is
	-- long enough to read twice.
	QUEST_PROMISE_SECONDS = 6,
	QUEST_CLAIMED_SECONDS = 8,

	-- ------------------------------------------------------------ persistence --
	-- Top-level profile key this feature owns (registered in PlayerData.luau).
	PROFILE_KEY = "TowerGame",
	-- leaderstats value names, shown on the in-game leaderboard.
	STAT_BLOCKS = "Blocks Placed",
	STAT_HEIGHT = "Biggest Height",

	-- -------------------------------------------------------- landing preview --
	-- The translucent ghost showing where the held piece would come to rest.
	-- Client-side and holder-only: it answers "does this fit there", which is the
	-- aiming player's question, and everyone's ghosts at once would be a wall of
	-- translucent blocks.
	SETTING_LANDING_PREVIEW = "tower.landingPreview",
	LANDING_TRANSPARENCY = 0.65,
	-- How far down the drop solve looks. Past this there's nothing under the
	-- piece worth landing on (it's aimed off the side), and the ghost hides
	-- rather than sitting at the bottom of the cast.
	LANDING_MAX_DROP = 400,

	-- ------------------------------------------------------------------ music --
	-- Setting id (registered in Settings.luau) for the zone playlist. TowerGame
	-- owns this row rather than reading the Music feature's `music.enabled`,
	-- because a feature that names another feature's setting id breaks the moment
	-- that feature is uninstalled — and the two constants would drift silently in
	-- the meantime. Music's own row registers only while its controller is live
	-- (see that feature's Constants.ENABLED), so exactly one "Music" toggle is
	-- ever on screen.
	SETTING_MUSIC = "tower.music",

	-- ------------------------------------------------------------- spectating --
	-- Setting id (registered in Settings.luau). On, the turn queue skips this
	-- player: they stay in the server, watch, react and chat, but never get a
	-- piece. Read on the *server* — a toggle the client alone honoured wouldn't
	-- be a rule, it'd be a suggestion.
	SETTING_NOT_PLAYING = "tower.notPlaying",

	-- ------------------------------------------------------------ double turn --
	-- Setting id (registered in Settings.luau) for the owner's own switch on the
	-- Double Turn gamepass. On by default — someone who bought the pass wants it —
	-- but taking two pieces every rotation is a thing you might not want in a room
	-- of four friends, and "sell them a perk they can't put down" is a bad trade.
	--
	-- The row is registered on both realms so the server can validate the write,
	-- and *shown* only to owners: the gate is set client-side in
	-- TowerSettingsPresentation, because ownership is a MarketplaceService answer.
	-- Read on the server, right next to the ownership check it qualifies.
	SETTING_DOUBLE_TURN = "tower.doubleTurn",

	-- --------------------------------------------------------------- phases --
	-- Broadcast as a uint8; the HUD reads it to pick its status line.
	PHASE = {
		IDLE = 0, -- nobody in the queue
		AIMING = 1, -- a player holds a piece and the clock is running
		SETTLING = 2, -- piece dropped, physics resolving
		CHECKPOINT = 3, -- stage cleared: play is paused for the demolition
		-- The storm took the tower. The round is over and the next one hasn't
		-- started: the wreck is flying, the screen is fading white, and the vote
		-- for the next round's rules runs inside this phase. Nothing may be
		-- placed while it's up — see `intermission` in TowerService.
		GAMEOVER = 4,
	},

	-- Which surfaces this feature renders. Flip one off to drop that surface
	-- without deleting code (see docs/game/presentations.md).
	Presentations = {
		hud = true,
		camera = true,
		input = true,
		-- Mouse aiming + click-to-drop. PC only; ignored on touch.
		pointer = true,
		-- `skipstage` — a dev handle on the stage clear. Gated by Cmdr's username
		-- allowlist like every other command; turn it off for a public build.
		command = true,
		-- The two Robux buttons on the left rail (Nuke, Next Checkpoint) and the
		-- server handlers behind them. Off = the products stop being offered and
		-- any receipt for one is left undelivered rather than silently eaten.
		actions = true,
		-- The "are you still there?" card, shown to a player the turn order has
		-- just dropped for inactivity. Off = they're still taken out of the
		-- rotation, they're just never told — so leave it on.
		afk = true,
	},
}
