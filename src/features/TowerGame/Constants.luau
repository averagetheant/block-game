-- Shared config / tunables for TowerGame.
-- Plain .luau file => shipped to ReplicatedStorage, readable from any realm.
--
-- The game is played on a single 2D plane (all blocks share Z = PLANE_Z) so the
-- physics reads like Tricky Towers rather than a 3D pile. TowerService enforces
-- that plane; everything here is the numbers it enforces it with.

return {
	-- ---------------------------------------------------------------- arena --
	-- Every block lives on this Z slice. The camera looks down -Z at it.
	PLANE_Z = 0,
	-- One tetromino cell. Blocks are cubes of BLOCK_SIZE with BLOCK_DEPTH depth;
	-- keeping depth == size makes the pieces stable against out-of-plane tipping.
	BLOCK_SIZE = 4,
	BLOCK_DEPTH = 4,
	-- Used for BOTH the starting base and every storm checkpoint platform, so a
	-- checkpoint is visibly "another floor" of the same building.
	PLATFORM_SIZE = Vector3.new(48, 4, 8),
	-- The foundation the tower is built on. Generated by TowerService unless a
	-- part tagged BASE_TAG already exists (see docs/game/TowerGame.md).
	BASE_TAG = "TowerBase",
	BASE_POSITION = Vector3.new(0, 40, 0),
	BASE_COLOR = Color3.fromRGB(56, 60, 74),
	ARENA_NAME = "TowerArena",
	-- Attribute on the arena folder holding the base's top surface Y. The client
	-- camera needs that number and can't get it from BASE_TAG: tags applied at
	-- runtime on the server do NOT replicate, while attributes do.
	BASE_TOP_ATTRIBUTE = "BaseTopY",
	-- Nobody walks around in a stationary-camera stacking game, so characters are
	-- off by default. Flip to false to get avatars back (they spawn at the world
	-- origin and are unrelated to the tower).
	DISABLE_CHARACTERS = true,

	-- ---------------------------------------------------------------- turns --
	-- Hard cap on how long the holder may aim before the piece drops itself.
	TURN_SECONDS = 20,
	-- Grace period after a drop before the next player is handed a piece.
	SETTLE_SECONDS = 1.5,
	-- How far above the current tower top a fresh piece is spawned.
	SPAWN_CLEARANCE = 18,
	-- Horizontal travel limit from the arena center, in studs. Just inside the
	-- platform's half width so a piece can overhang but not fly off into space.
	STEER_LIMIT_X = 22,
	-- Studs per second while a direction is held. Steering is continuous, not
	-- one cell per press.
	STEER_SPEED = 18,
	-- A touch tap has no key-up, so the HUD buttons send a pulse of this length
	-- instead: one tap ≈ STEER_SPEED * TOUCH_NUDGE_SECONDS studs of travel.
	TOUCH_NUDGE_SECONDS = 0.16,

	-- ---------------------------------------------------------------- storm --
	-- The pressure mechanic: reach the target height before the clock runs out
	-- and the tower gains a permanent floor to build on.
	STORM_SECONDS = 90,
	-- The first target, in studs above the base. Each cleared stage adds another
	-- STORM_TARGET_STEP on top of the height that cleared it.
	STORM_FIRST_TARGET = 32,
	STORM_TARGET_STEP = 28,
	-- Checkpoint platform entrance: stretches out from a sliver, glowing white,
	-- then cools to black.
	PLATFORM_GROW_SECONDS = 0.45,
	PLATFORM_FADE_SECONDS = 1.1,
	PLATFORM_SPAWN_COLOR = Color3.fromRGB(255, 255, 255),
	PLATFORM_SETTLED_COLOR = Color3.fromRGB(12, 12, 16),

	-- --------------------------------------------------------------- physics --
	-- Grippy and dead: high friction so a stack doesn't slide itself apart, zero
	-- elasticity so a dropped piece lands instead of bouncing off the tower.
	-- (density, friction, elasticity, frictionWeight, elasticityWeight)
	BLOCK_PHYSICS = PhysicalProperties.new(0.8, 0.9, 0, 10, 1),
	-- A block counts toward the tower height once its assembly is this slow.
	SETTLED_SPEED = 0.6,
	-- Blocks that fall this far below the base top are cleaned up. Pieces only
	-- ever spawn *above* the tower, so anything under the platform has fallen off
	-- the side — and if the place has a baseplate it would otherwise sit there
	-- forever instead of falling out of the world.
	DESPAWN_BELOW = 20,
	-- Out-of-plane drift past this many studs gets corrected (the velocity clamp
	-- handles the rest).
	PLANE_TOLERANCE = 0.25,

	-- --------------------------------------------------------------- tempo --
	-- Height recompute + state broadcast interval, seconds.
	POLL_INTERVAL = 0.2,
	-- Height change that's worth a broadcast, studs.
	HEIGHT_EPSILON = 0.05,

	-- --------------------------------------------------------------- camera --
	-- Stationary framing: the camera never orbits, it only rides the altitude of
	-- the tower's highest point.
	CAMERA_DISTANCE = 78,
	-- The camera looks dead level at a point this far above the tower top, which
	-- puts the tower and the piece waiting at SPAWN_CLEARANCE both in frame.
	CAMERA_AIM_LIFT = 10,
	-- Minimum altitude the camera frames, so an empty base isn't at the top edge.
	CAMERA_MIN_HEIGHT = 14,
	-- Exponential follow rate (higher = snappier).
	CAMERA_LERP = 4,
	CAMERA_FOV = 60,

	-- ------------------------------------------------------------ persistence --
	-- Top-level profile key this feature owns (registered in PlayerData.luau).
	PROFILE_KEY = "TowerGame",
	-- leaderstats value names, shown on the in-game leaderboard.
	STAT_BLOCKS = "Blocks Placed",
	STAT_HEIGHT = "Biggest Height",

	-- --------------------------------------------------------------- phases --
	-- Broadcast as a uint8; the HUD reads it to pick its status line.
	PHASE = {
		IDLE = 0, -- nobody in the queue
		AIMING = 1, -- a player holds a piece and the clock is running
		SETTLING = 2, -- piece dropped, physics resolving
	},

	-- Which surfaces this feature renders. Flip one off to drop that surface
	-- without deleting code (see docs/game/presentations.md).
	Presentations = {
		hud = true,
		camera = true,
		input = true,
	},
}
